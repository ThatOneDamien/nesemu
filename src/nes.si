pub mod sdl;
pub mod cpu;
pub mod types;

import types::*;

extern fn fprintf(fp: *void, fmt: CString, ...) void;
extern fn printf(fmt: CString, ...) void;
extern fn open(path: CString, flags: int, ...) int;
extern fn close(fd: int) int;
extern fn read(fd: int, buf: *void, count: usize) isize;
extern fn lseek(fd: int, offset: isize, whence: int) isize;
extern fn malloc(size: usize) *void;

extern const stderr: *void;

#const O_RDONLY: int = 0;
#const SEEK_SET: int = 0;
#const SEEK_END: int = 2;
#const NES_CONSTANT: uint = 0x1A53454E;


fn main(args: []CString) int
{
    if args.len < 2 {
        printf("Usage: %s [ROM path]\n", args[0]);
        return 0;
    }

    const fd = open(args[1], O_RDONLY);
    if fd < 0 {
        fprintf(stderr, "Failed to open file %s\n", args[1]);
        return 1;
    }

    const sz = cast<usize>(lseek(fd, 0, SEEK_END));
    printf("size of file: %ld\n", sz);
    lseek(fd, 0, SEEK_SET);

    const buf = cast<*ROMData>(malloc(sz));
    read(fd, buf, sz);
    if buf.nes_constant == NES_CONSTANT {
        printf("Successful! %u %u\n", cast<uint>(buf.prg_rom_size) * 0x4000, cast<uint>(buf.chr_rom_size) * 0x2000);
    }

    close(fd);
    // if !start_window_loop() {
    //     return 1;
    // }
    return 0;
}

fn start_window_loop() bool 
{
    if(!sdl::Init(sdl::INIT_VIDEO))
	{
		printf("Failed to initialize SDL: %s", sdl::GetError());
		return false;
	}
    
    const win = sdl::CreateWindow("My Bum Ah Nes Emulator", 800, 600, 0);
    if (win == null) {
        printf("CreateWindow failed: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    const window = win!;
    const ren = sdl::CreateRenderer(window, null);
    if (ren == null) {
        printf("CreateRenderer failed: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    const renderer = ren!;

    var running = true;
    var event: sdl::Event;

    while (running) {
        while (sdl::PollEvent(&event)) {
            if (event.type == sdl::EVENT_QUIT) {
                running = false;
            }
        }

        sdl::SetRenderDrawColor(renderer, 0, 12, 59, 255);
        sdl::RenderClear(renderer);

        sdl::RenderPresent(renderer);

        sdl::Delay(16); // ~60 FPS idle loop
    }

    sdl::DestroyWindow(window);
    sdl::Quit();
    return true;
}
