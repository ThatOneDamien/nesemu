pub typedef InitFlags = uint;
pub typedef Window = void;
pub typedef Renderer = void;
pub typedef Texture = void;
pub typedef WindowFlags = ulong;
pub typedef SDLString = *[*]const char;

pub #const INIT_VIDEO: InitFlags = 0x00000020;


@link_name("SDL_Init")
pub extern fn Init(flags: InitFlags) bool;
@link_name("SDL_Quit")
pub extern fn Quit() void;
@link_name("SDL_GetError")
pub extern fn GetError() SDLString;
@link_name("SDL_CreateWindow")
pub extern fn CreateWindow(title: SDLString, w: int, h: int, flags: WindowFlags) ?*Window;
@link_name("SDL_DestroyWindow")
pub extern fn DestroyWindow(window: *Window) void;
@link_name("SDL_CreateRenderer")
pub extern fn CreateRenderer(window: *Window, name: ?SDLString) ?*Renderer;
@link_name("SDL_SetRenderDrawColor")
pub extern fn SetRenderDrawColor(renderer: *Renderer, r: ubyte, g: ubyte, b: ubyte, a: ubyte) bool;
@link_name("SDL_RenderClear")
pub extern fn RenderClear(renderer: *Renderer) bool;
@link_name("SDL_RenderPresent")
pub extern fn RenderPresent(renderer: *Renderer) bool;
@link_name("SDL_RenderTexture")
pub extern fn RenderTexture(renderer: *Renderer, texture: *Texture, srcrect: ?*const FRect, dstrect: ?*const FRect) bool;
@link_name("SDL_CreateTexture")
pub extern fn CreateTexture(renderer: *Renderer, format: PixelFormat, access: TextureAccess, w: int, h: int) ?*Texture;
@link_name("SDL_LockTexture")
pub extern fn LockTexture(texture: *Texture, rect: ?*const Rect, pixels: **void, pitch: *int) bool;
@link_name("SDL_UnlockTexture")
pub extern fn UnlockTexture(texture: *Texture) void;
@link_name("SDL_DelayNS")
pub extern fn DelayNS(ns: ulong) void;
@link_name("SDL_PollEvent")
pub extern fn PollEvent(event: *Event) bool;
@link_name("SDL_GetPerformanceCounter")
pub extern fn GetPerformanceCounter() ulong;
@link_name("SDL_GetPerformanceFrequency")
pub extern fn GetPerformanceFrequency() ulong;
@link_name("SDL_GetKeyboardState")
pub extern fn GetKeyboardState(numkeys: *int) *[*]const bool;

pub union Event
{
    type: EventType,
    padding: [128]ubyte
}

pub struct Rect
{
    x: int,
    y: int,
    w: int,
    h: int,
}

pub struct FRect
{
    x: float,
    y: float,
    w: float,
    h: float,
}

