import CString;
import io;
import bus;
import todo;
import context;

struct Instr 
{
    kind: InstrKind,
    addr_mode: AddrMode,
    cycles: ubyte,
    bytes: ubyte,
    page_cross_penalty: bool,
}

pub struct CPU
{
    debug_cycles: ulong,

    a: ubyte,
    x: ubyte,
    y: ubyte,
    sp: ubyte,
    pc: ushort,
    status: StatusReg,
    current_cycles: ulong,
    total_cycles: ulong,

    nmi_pending: bool,
    halted: bool,
}

pub struct StatusReg
{
    c: bool,
    z: bool,
    i: bool,
    d: bool,
    v: bool,
    n: bool,
}

struct Operand
{
    addr: ushort,
    dummy_addr: ushort,
    page_crossed: bool,
    addr_mode: AddrMode,
}

pub fn power() void
{
    cpu.a  = 0x00;
    cpu.x  = 0x00;
    cpu.y  = 0x00;
    cpu.sp = 0xFD;
    cpu.status = StatusReg {
        i: true,
    };
    cpu.pc = bus::read16(0xFFFC);
    cpu.total_cycles = 7;
    cpu.current_cycles = 0;
    cpu.nmi_pending = false;
    cpu.halted = false;
}

pub fn reset() void
{
    cpu.sp -= 3;
    cpu.status.i = true;
    cpu.pc = bus::read16(0xFFFC);
    cpu.current_cycles = 0;
    cpu.nmi_pending = false;
}

#const cpu = &context.cpu;

pub fn clock() void
{
    cpu.debug_cycles++;
    if cpu.halted { return; }
    if cpu.current_cycles == 0 {
        if cpu.nmi_pending {
            nmi();
            cpu.nmi_pending = false;
        }
        else if irq_requested() {
            irq();
        }
        else {
            const opcode = bus::read(cpu.pc);
            const instr = &opcodes[opcode];

            // print_state(opcode, instr);

            cpu.pc++;
            cpu.current_cycles = instr.cycles;
            var operand = resolve_operand(instr.addr_mode);
            dispatch_instruction(instr, &operand);
        }
    }
    cpu.current_cycles--;
    cpu.total_cycles++;
}

pub fn stall(cycles: ulong) void
{
    cpu.current_cycles += cycles;
}

fn irq_requested() bool
{
    return !cpu.status.i && (context.apu.frame_irq || context.apu.dmc_irq);
}


