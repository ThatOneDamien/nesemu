import CString;
import io;
import bus;
import todo;
import context;

struct Instr 
{
    kind: InstrKind,
    addr_mode: AddrMode,
    cycles: ubyte,
    bytes: ubyte,
    page_cross_penalty: bool,
}

pub struct CPU
{
    a: ubyte,
    x: ubyte,
    y: ubyte,
    sp: ubyte,
    pc: ushort,
    status: StatusReg,
    cycles: ulong,
    nmi_pending: bool,
}

pub struct StatusReg
{
    c: bool,
    z: bool,
    i: bool,
    d: bool,
    v: bool,
    n: bool,
}

struct Operand
{
    addr: ushort,
    value: ?ubyte,
    page_crossed: bool,
}

fn Operand.load_value(op: *Operand) ubyte 
{
    if op.value != null { return op.value!; }
    op.value = bus::read(op.addr);
    return op.value!;
}

pub fn reset() void
{
    cpu.a  = 0x00;
    cpu.x  = 0x00;
    cpu.y  = 0x00;
    cpu.sp = 0xFD;
    cpu.status = StatusReg {
        i: true,
    };
    cpu.pc = bus::read16(0xFFFC);
    // Temporary
    // cpu.cycles = 7;
    // context.ppu.cycle = 21;
}

pub fn set_debug_entry(pc: ushort) void
{
    cpu.pc = pc;
}

#const cpu = &context.cpu;

pub fn step() ubyte
{
    const original_cycles = cpu.cycles;
    const opcode = bus::read(cpu.pc);
    const instr = &opcodes[opcode];

    print_state(opcode, instr);

    cpu.pc++;
    var operand = resolve_operand(instr.addr_mode);
    dispatch_instruction(instr, &operand);
    cpu.cycles += instr.cycles;
    return cast<ubyte>(cpu.cycles - original_cycles);
}

fn print_state(opcode: ubyte, instr: *const Instr) void
{
    
    // io::printf("(CPU) PC:%.4hX  %.2hhX ", cpu.pc, opcode);
    // if instr.bytes == 1 {
    //     io::printf("     ");
    // } else if instr.bytes == 2 {
    //     io::printf("%.2hhX   ", bus::read(cpu.pc + 1));
    // } else if instr.bytes == 3 {
    //     io::printf("%.2hhX %.2hhX", bus::read(cpu.pc + 1), bus::read(cpu.pc + 2));
    // }
    // io::printf("  %s    A:%.2hhX X:%.2hhX Y:%.2hhX SP:%.2hhX CZIDVN:%1u%1u%1u%1u%1u%1u Cycles:%lu AddrMode:%-12s\n", 
    //            instr_kind_to_str[instr.kind], 
    //            cpu.a, cpu.x, cpu.y, cpu.sp,
    //            cpu.status.c, cpu.status.z, cpu.status.i, cpu.status.d, cpu.status.v, cpu.status.n,
    //            cpu.cycles,
    //            addr_mode_to_str[instr.addr_mode]);

    // For nestest
    io::printf("%.4hX  %.2hhX ", cpu.pc, opcode);
    if instr.bytes == 1 {
        io::printf("     ");
    } else if instr.bytes == 2 {
        io::printf("%.2hhX   ", bus::read(cpu.pc + 1));
    } else if instr.bytes == 3 {
        io::printf("%.2hhX %.2hhX", bus::read(cpu.pc + 1), bus::read(cpu.pc + 2));
    }
    io::printf("  %s  A:%.2hhX X:%.2hhX Y:%.2hhX P:%.2hhX SP:%.2hhX PPU:%3hu,%3hu CYC:%lu\n",
               instr_kind_to_str[instr.kind],
               cpu.a, cpu.x, cpu.y, get_status(false), cpu.sp,
               context.ppu.scanline, context.ppu.cycle % 341,
               cpu.cycles);

}

pub fn check_nmi() void
{
    if cpu.nmi_pending {
        cpu.nmi_pending = false;
        stack_push16(cpu.pc);
        // push status (with correct flags handling)
        stack_push(get_status(false));

        // disable interrupts
        cpu.status.i = true;

        // jump to NMI vector
        cpu.pc = bus::read16(0xFFFA);
        cpu.cycles += 7;
    }
}

fn resolve_operand(mode: AddrMode) Operand
{
    var operand = Operand{}; 
    switch mode {
    case AddrMode.Implied: break;
    case AddrMode.Accumulator:
        operand.value = cpu.a;
    case AddrMode.Immediate:
        operand.addr = cpu.pc;
        operand.value = bus::read(cpu.pc);
        cpu.pc++;
    case AddrMode.ZeroPage:
        operand.addr = bus::read(cpu.pc);
        cpu.pc++;
    case AddrMode.ZeroPageX:
        operand.addr = (bus::read(cpu.pc) + cpu.x) & 0xFF;
        cpu.pc++;
    case AddrMode.ZeroPageY:
        operand.addr = (bus::read(cpu.pc) + cpu.y) & 0xFF;
        cpu.pc++;
    case AddrMode.Absolute:
        operand.addr = bus::read16(cpu.pc); 
        cpu.pc += 2;
    case AddrMode.AbsoluteX:
        const base = bus::read16(cpu.pc);
        operand.addr = base + cpu.x;
        operand.page_crossed = did_cross_page(base, operand.addr);
        cpu.pc += 2;
    case AddrMode.AbsoluteY:
        const base = bus::read16(cpu.pc);
        operand.addr = base + cpu.y;
        operand.page_crossed = did_cross_page(base, operand.addr);
        cpu.pc += 2;
    case AddrMode.Relative:
        const offset = cast<byte>(bus::read(cpu.pc));
        cpu.pc++;
        operand.addr = cpu.pc + cast<ushort>(cast<short>(offset));
    case AddrMode.Indirect:
        const ptr = bus::read16(cpu.pc);
        cpu.pc += 2;

        // emulate 6502 page boundary hardware bug
        const lo = bus::read(ptr);
        var hi_addr: ushort = void;
        if (ptr & 0x00FF) != 0 {
            hi_addr = ptr & 0xFF00;
        } else {
            hi_addr = ptr + 1;
        }

        const hi = bus::read(hi_addr);

        operand.addr = (cast<ushort>(hi) << 8) | lo;
    case AddrMode.IndirectX:
        const base = bus::read(cpu.pc) + cpu.x;
        cpu.pc++;
        const lo = bus::read(cast<ushort>(base));
        const hi = bus::read(cast<ushort>(base + 1));
        operand.addr = (cast<ushort>(hi) << 8) | lo;
    case AddrMode.IndirectY:
        const base = bus::read(cpu.pc);
        cpu.pc++;
        const lo = bus::read(cast<ushort>(base));
        const hi = bus::read(cast<ushort>(base + 1));
        const base_addr = (cast<ushort>(hi) << 8) | lo;
        operand.addr = base_addr + cpu.y;
        operand.page_crossed = did_cross_page(base_addr, operand.addr);
    default:
        io::printf("Bad addressing mode.\n");
    }
    return operand;
}

fn did_cross_page(base: ushort, addr: ushort) bool
{
    return (base & 0xFF00) != (addr & 0xFF00);
}

fn dispatch_instruction(instr: *const Instr, operand: *Operand) void
{
    switch instr.kind {
    case InstrKind.Invalid:
        io::printf("Bad instruction.");
    case InstrKind.ADC:
        const val = operand.load_value();
        const result_full: ushort = cast<ushort>(cpu.a) + val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case InstrKind.AND:
        cpu.a &= operand.load_value();
        set_nz(cpu.a);
    case InstrKind.ASL:
        const val = operand.load_value();
        const result = val << 1;
        set_mem_or_acc(result, operand, instr);
        cpu.status.c = (val >> 7) != 0;
        set_nz(result);
    case InstrKind.BCC:
        branch_if_cond(!cpu.status.c, operand);
    case InstrKind.BCS:
        branch_if_cond(cpu.status.c, operand);
    case InstrKind.BEQ:
        branch_if_cond(cpu.status.z, operand);
    case InstrKind.BIT:
        const val = operand.load_value();
        const result = cpu.a & val;
        cpu.status.z = result == 0;
        cpu.status.n = (val & (1 << 7)) != 0;
        cpu.status.v = (val & (1 << 6)) != 0;
    case InstrKind.BMI:
        branch_if_cond(cpu.status.n, operand);
    case InstrKind.BNE:
        branch_if_cond(!cpu.status.z, operand);
    case InstrKind.BPL:
        branch_if_cond(!cpu.status.n, operand);
    case InstrKind.BRK:
        cpu.pc++;
        stack_push16(cpu.pc);
        stack_push(get_status(true));
        cpu.status.i = true;
        cpu.pc = bus::read16(0xFFFE);

    case InstrKind.BVC:
        branch_if_cond(!cpu.status.v, operand);
    case InstrKind.BVS:
        branch_if_cond(cpu.status.v, operand);
    case InstrKind.CLC:
        cpu.status.c = false;
    case InstrKind.CLD:
        cpu.status.d = false;
    case InstrKind.CLI:
        cpu.status.i = false;
    case InstrKind.CLV:
        cpu.status.v = false;
    case InstrKind.CMP:
        compare_op(cpu.a, operand.load_value());
    case InstrKind.CPX:
        compare_op(cpu.x, operand.load_value());
    case InstrKind.CPY:
        compare_op(cpu.y, operand.load_value());
    case InstrKind.DEC:
        const result = operand.load_value() - 1;
        bus::write(operand.addr, result);
        set_nz(result);
    case InstrKind.DEX:
        set_nz(--cpu.x);
    case InstrKind.DEY:
        set_nz(--cpu.y);
    case InstrKind.EOR:
        cpu.a = cpu.a ^ operand.load_value();
        set_nz(cpu.a);
    case InstrKind.INC:
        const result = operand.load_value() + 1;
        bus::write(operand.addr, result);
        set_nz(result);
    case InstrKind.INX:
        set_nz(++cpu.x);
    case InstrKind.INY:
        set_nz(++cpu.y);
    case InstrKind.JMP:
        cpu.pc = operand.addr;
    case InstrKind.JSR:
        stack_push16(cpu.pc - 1);
        cpu.pc = operand.addr;
    case InstrKind.LDA:
        cpu.a = operand.load_value();
        set_nz(cpu.a);
    case InstrKind.LDX:
        cpu.x = operand.load_value();
        set_nz(cpu.x);
    case InstrKind.LDY:
        cpu.y = operand.load_value();
        set_nz(cpu.y);
    case InstrKind.LSR:
        const val = operand.load_value();
        const result = val >> 1;
        set_mem_or_acc(result, operand, instr);
        cpu.status.c = (val & 1) != 0;
        cpu.status.n = false;
        cpu.status.z = result == 0;
    case InstrKind.NOP:
        break;
    case InstrKind.ORA:
        cpu.a |= operand.load_value();
        set_nz(cpu.a);
    case InstrKind.PHA:
        stack_push(cpu.a);
    case InstrKind.PHP:
        stack_push(get_status(true));
    case InstrKind.PLA:
        cpu.a = stack_pop();
        set_nz(cpu.a);
    case InstrKind.PLP:
        pop_status();
    case InstrKind.ROL:
        const val = operand.load_value();
        const result = (val << 1) | cast<ubyte>(cpu.status.c);
        set_mem_or_acc(result, operand, instr);
        cpu.status.c = (val & 0x80) != 0;
        set_nz(result);
    case InstrKind.ROR:
        const val = operand.load_value();
        const result = (val >> 1) | (cast<ubyte>(cpu.status.c) << 7);
        set_mem_or_acc(result, operand, instr);
        cpu.status.c = (val & 0x1) != 0;
        set_nz(result);
    case InstrKind.RTI:
        pop_status();
        cpu.pc = stack_pop16();
    case InstrKind.RTS:
        cpu.pc = stack_pop16() + 1;
    case InstrKind.SBC:
        const not_val = ~operand.load_value();
        const result_full: ushort = cast<ushort>(cpu.a) + not_val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ not_val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case InstrKind.SEC:
        cpu.status.c = true;
    case InstrKind.SED:
        cpu.status.d = true;
    case InstrKind.SEI:
        cpu.status.i = true;
    case InstrKind.STA:
        bus::write(operand.addr, cpu.a);
    case InstrKind.STX:
        bus::write(operand.addr, cpu.x);
    case InstrKind.STY:
        bus::write(operand.addr, cpu.y);
    case InstrKind.TAX:
        cpu.x = cpu.a;
        set_nz(cpu.x);
    case InstrKind.TAY:
        cpu.y = cpu.a;
        set_nz(cpu.y);
    case InstrKind.TSX:
        cpu.x = cpu.sp;
        set_nz(cpu.x);
    case InstrKind.TXA:
        cpu.a = cpu.x;
        set_nz(cpu.a);
    case InstrKind.TXS:
        cpu.sp = cpu.x;
    case InstrKind.TYA:
        cpu.a = cpu.y;
        set_nz(cpu.a);
    case InstrKind.ALR:
    case InstrKind.ANC:
    case InstrKind.ARR:
    case InstrKind.AXS:
        todo(null);
    case InstrKind.DCP:
        const val = operand.load_value() - 1;
        bus::write(operand.addr, val);
        compare_op(cpu.a, val);
    case InstrKind.ISB:
        const val = operand.load_value() + 1;
        bus::write(operand.addr, val);

        const not_val = ~val;
        const result_full: ushort = cast<ushort>(cpu.a) + not_val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ not_val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case InstrKind.LAS:
        todo(null);
    case InstrKind.LAX:
        const val = operand.load_value();
        cpu.a = val;
        cpu.x = val;
        set_nz(val);
    case InstrKind.RLA:
        var val = operand.load_value();

        const new_c = (val & 0x80) != 0;
        val = (val << 1) | cast<ubyte>(cpu.status.c);
        cpu.status.c = new_c;

        bus::write(operand.addr, val);

        cpu.a &= val;
        set_nz(cpu.a);
    case InstrKind.RRA:
        const val = operand.load_value();
        const result = (val >> 1) | (cast<ubyte>(cpu.status.c) << 7);
        set_mem_or_acc(result, operand, instr);
        const carry = val & 0x1;
        const adc_full: ushort = cast<ushort>(cpu.a) + result + carry;
        const adc = cast<ubyte>(adc_full);
        cpu.status.c = adc_full > 0xFF;
        cpu.status.v = ((adc ^ cpu.a) & (adc ^ result) & 0x80) != 0;
        cpu.a = adc;
        set_nz(cpu.a);
    case InstrKind.SAX:
        const val = cpu.a & cpu.x;
        bus::write(operand.addr, val);
    case InstrKind.SHX:
    case InstrKind.SHY:
        todo(null);
    case InstrKind.SLO:
        var val = operand.load_value();
        cpu.status.c = (val & 0x80) != 0;

        val = val << 1;
        bus::write(operand.addr, val);

        cpu.a |= val;
        set_nz(cpu.a);
    case InstrKind.SRE:
        var val = operand.load_value();
        cpu.status.c = (val & 0x01) != 0;

        val = val >> 1;
        bus::write(operand.addr, val);

        cpu.a ^= val;
        set_nz(cpu.a);
    case InstrKind.TAS:
    case InstrKind.XAA:
    case InstrKind.AHX:
    case InstrKind.STP:
        todo(null);
    }
    if operand.page_crossed && instr.page_cross_penalty {
        cpu.cycles++;
    }

}

fn set_mem_or_acc(value: ubyte, operand: *const Operand, instr: *const Instr) void
{
    if instr.addr_mode == AddrMode.Accumulator {
        cpu.a = value;
    } else {
        bus::write(operand.addr, value);
    }

}

fn branch_if_cond(cond: bool, operand: *const Operand) void
{
    if cond {
        if did_cross_page(cpu.pc, operand.addr) {
            cpu.cycles++;
        }
        cpu.pc = operand.addr;
        cpu.cycles++;
    }
}

fn compare_op(regval: ubyte, val: ubyte) void
{
    const result = regval - val;
    cpu.status.c = regval >= val;
    cpu.status.z = regval == val;
    cpu.status.n = (result >> 7) != 0;
}

fn set_nz(result: ubyte) void
{
    cpu.status.n = (result >> 7) != 0;
    cpu.status.z = result == 0;
}

fn stack_push(value: ubyte) void
{
    bus::write(0x0100 | cpu.sp, value);
    cpu.sp--;
}

fn stack_push16(value: ushort) void
{
    stack_push(cast<ubyte>(value >> 8));
    stack_push(cast<ubyte>(value));
}

fn stack_pop() ubyte
{
    cpu.sp++;
    return bus::read(0x0100 | cpu.sp);
}

fn stack_pop16() ushort
{
    const lo = cast<ushort>(stack_pop());
    const hi = cast<ushort>(stack_pop());
    return (hi << 8) | lo;
}

fn pop_status() void
{
    const status = stack_pop();
    cpu.status.c = (status & (1 << 0)) != 0;
    cpu.status.z = (status & (1 << 1)) != 0;
    cpu.status.i = (status & (1 << 2)) != 0;
    cpu.status.d = (status & (1 << 3)) != 0;
    cpu.status.v = (status & (1 << 6)) != 0;
    cpu.status.n = (status & (1 << 7)) != 0;
}

fn get_status(break_flag: bool) ubyte
{
    return
        (cast<ubyte>(cpu.status.c) << 0) |
        (cast<ubyte>(cpu.status.z) << 1) |
        (cast<ubyte>(cpu.status.i) << 2) |
        (cast<ubyte>(cpu.status.d) << 3) |
        (cast<ubyte>(break_flag)   << 4) | // B is set to 1 for pushes, 0 for IRQ/NMI
        (1                         << 5) | // unused bit, usually set
        (cast<ubyte>(cpu.status.v) << 6) |
        (cast<ubyte>(cpu.status.n) << 7);
}

pub fn cycle(count: uint) void
{
    cpu.cycles += count;
}


enum InstrKind : ubyte
{
    Invalid,
    // Official
    ADC,
    AND,
    ASL,
    BCC,
    BCS,
    BEQ,
    BIT,
    BMI,
    BNE,
    BPL,
    BRK,
    BVC,
    BVS,
    CLC,
    CLD,
    CLI,
    CLV,
    CMP,
    CPX,
    CPY,
    DEC,
    DEX,
    DEY,
    EOR,
    INC,
    INX,
    INY,
    JMP,
    JSR,
    LDA,
    LDX,
    LDY,
    LSR,
    NOP,
    ORA,
    PHA,
    PHP,
    PLA,
    PLP,
    ROL,
    ROR,
    RTI,
    RTS,
    SBC,
    SEC,
    SED,
    SEI,
    STA,
    STX,
    STY,
    TAX,
    TAY,
    TSX,
    TXA,
    TXS,
    TYA,

    // Unofficial / Illegal
    ALR,
    ANC,
    ARR,
    AXS,
    DCP,
    ISB,
    LAS,
    LAX,
    RLA,
    RRA,
    SAX,
    SHX,
    SHY,
    SLO,
    SRE,
    TAS,
    XAA,
    AHX,
    STP,
}

enum AddrMode : ubyte
{
    None,
    Implied,
    Accumulator,
    Immediate,
    ZeroPage,
    ZeroPageX,
    ZeroPageY,
    Absolute,
    AbsoluteX,
    AbsoluteY,
    Relative,
    Indirect,
    IndirectX,
    IndirectY,
}

