import types::*;
import io;
import bus;
import todo;

struct Opcode
{
    instr: Instr,
    addr_mode: AddrMode,
    cycles: ubyte,
    bytes: ubyte,
    page_cross_penalty: bool,
}

struct CPU
{
    a: ubyte,
    x: ubyte,
    y: ubyte,
    sp: ubyte,
    pc: ushort,
    status: ubyte,
    cycles: ulong,
}

struct Operand
{
    mode: AddrMode,
    addr: ushort,
    value: ubyte,
    page_crossed: bool,
}

var cpu: CPU;

pub fn step() void
{
    const next_instr = bus::read(cpu.pc);
    const opcode = opcodes[next_instr];
    io::printf("(CPU) [0x%.2hhX] OP:\"%s\" AddrMode:%-12s  PC:0x%.4hX   A:0x%.2hhX   X:0x%.2hhX   Y:0x%.2hhX\n", 
               next_instr, 
               instr_to_str[opcode.instr], 
               addr_mode_to_str[opcode.addr_mode],
               cpu.pc, cpu.a, cpu.x, cpu.y);

    cpu.pc++;
    resolve_operand(opcode.addr_mode);

    cpu.cycles += opcode.cycles;
}

pub fn cycle(count: uint) void
{
    cpu.cycles += count;
}

pub fn set_pc(pc: ushort) void
{
    cpu.pc = pc;
}

fn resolve_operand(mode: AddrMode) Operand
{
    var operand = Operand{ mode: mode }; 
    switch mode {
    case AddrMode.Implied:
    case AddrMode.Accumulator:
        break;
    case AddrMode.Immediate:
        operand.addr = cpu.pc;
        operand.value = bus::read(cpu.pc);
        cpu.pc++;
    case AddrMode.ZeroPage:
        operand.addr = bus::read(cpu.pc);
        cpu.pc++;
        operand.value = bus::read(operand.addr);
    case AddrMode.ZeroPageX:
    case AddrMode.ZeroPageY:
        todo(null);
    case AddrMode.Absolute:
        operand.addr = bus::read16(cpu.pc); 
        cpu.pc += 2;
        operand.value = bus::read(operand.addr);
    case AddrMode.AbsoluteX:
    case AddrMode.AbsoluteY:
        todo(null);
    case AddrMode.Relative:
        const offset = cast<byte>(bus::read(cpu.pc));
        cpu.pc++;
        operand.addr = cpu.pc + cast<ushort>(cast<short>(offset));
    case AddrMode.Indirect:
    case AddrMode.IndirectX:
    case AddrMode.IndirectY:
        todo(null);
    default:
        io::printf("Bad addressing mode.\n");
    }
    return operand;
}

enum Instr : ubyte
{
    // Official
    NOP,
    ADC,
    AND,
    ASL,
    BCC,
    BCS,
    BEQ,
    BIT,
    BMI,
    BNE,
    BPL,
    BRK,
    BVC,
    BVS,
    CLC,
    CLD,
    CLI,
    CLV,
    CMP,
    CPX,
    CPY,
    DEC,
    DEX,
    DEY,
    EOR,
    INC,
    INX,
    INY,
    JMP,
    JSR,
    LDA,
    LDX,
    LDY,
    LSR,
    ORA,
    PHA,
    PHP,
    PLA,
    PLP,
    ROL,
    ROR,
    RTI,
    RTS,
    SBC,
    SEC,
    SED,
    SEI,
    STA,
    STX,
    STY,
    TAX,
    TAY,
    TSX,
    TXA,
    TXS,
    TYA,

    // Unofficial / Illegal
    ALR,
    ANC,
    ARR,
    AXS,
    DCP,
    ISC,
    LAS,
    LAX,
    RLA,
    RRA,
    SAX,
    SHX,
    SHY,
    SLO,
    SRE,
    TAS,
    XAA,
    AHX,
    STP,
}

enum AddrMode : ubyte
{
    None,
    Implied,
    Accumulator,
    Immediate,
    ZeroPage,
    ZeroPageX,
    ZeroPageY,
    Absolute,
    AbsoluteX,
    AbsoluteY,
    Relative,
    Indirect,
    IndirectX,
    IndirectY,
}

