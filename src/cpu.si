    // }
    // io::printf("  %s    A:%.2hhX X:%.2hhX Y:%.2hhX SP:%.2hhX CZIDVN:%1u%1u%1u%1u%1u%1u Cycles:%lu AddrMode:%-12s\n", 
    //            instr_kind_to_str[instr.kind], 
