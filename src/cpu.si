    // For nestest
    io::printf("%.4hX  %.2hhX ", cpu.pc, opcode);
    if instr.bytes == 1 {
        io::printf("     ");
    } else if instr.bytes == 2 {
        io::printf("%.2hhX   ", bus::read(cpu.pc + 1));
    } else if instr.bytes == 3 {
        io::printf("%.2hhX %.2hhX", bus::read(cpu.pc + 1), bus::read(cpu.pc + 2));
    }
    io::printf("  %s  A:%.2hhX X:%.2hhX Y:%.2hhX P:%.2hhX SP:%.2hhX PPU:%3hu,%3hu CYC:%lu\n",
               instr_kind_to_str[instr.kind],
               cpu.a, cpu.x, cpu.y, get_status(false), cpu.sp,
               context.ppu.scanline, context.ppu.cycle % 341,
               cpu.total_cycles);

}

pub fn irq() void
{
    stack_push16(cpu.pc);
    stack_push(get_status(false));

    // disable interrupts
    cpu.status.i = true;

    // Read new program counter location from fixed address
    cpu.pc = bus::read16(0xFFFE);
    // IRQs take time
    cpu.current_cycles = 8;
}

pub fn nmi() void
{
    stack_push16(cpu.pc);
    // push status (with correct flags handling)
    stack_push(get_status(false));

    // disable interrupts
    cpu.status.i = true;

    // jump to NMI vector
    cpu.pc = bus::read16(0xFFFA);
    cpu.current_cycles = 7;
}

fn resolve_operand(mode: AddrMode) Operand
{
    var operand = Operand{}; 
    operand.addr_mode = mode;
    switch mode {
    case .Implied:
    case .Accumulator:
        break;
    case .Immediate:
        operand.addr = cpu.pc;
        cpu.pc++;
    case .ZeroPage:
        operand.addr = bus::read(cpu.pc);
        cpu.pc++;
    case .ZeroPageX:
        operand.addr = (bus::read(cpu.pc) + cpu.x) & 0xFF;
        cpu.pc++;
    case .ZeroPageY:
        operand.addr = (bus::read(cpu.pc) + cpu.y) & 0xFF;
        cpu.pc++;
    case .Absolute:
        operand.addr = bus::read16(cpu.pc); 
        cpu.pc += 2;
    case .AbsoluteX:
        const base = bus::read16(cpu.pc);
        operand.addr = base + cpu.x;
        operand.page_crossed = did_cross_page(base, operand.addr);
        operand.dummy_addr = (base & 0xFF00) | (operand.addr & 0x00FF);
        cpu.pc += 2;
    case .AbsoluteY:
        const base = bus::read16(cpu.pc);
        operand.addr = base + cpu.y;
        operand.page_crossed = did_cross_page(base, operand.addr);
        operand.dummy_addr = (base & 0xFF00) | (operand.addr & 0x00FF);
        cpu.pc += 2;
    case .Relative:
        const offset = cast<byte>(bus::read(cpu.pc));
        cpu.pc++;
        operand.addr = cpu.pc + cast<ushort>(cast<short>(offset));
    case .Indirect:
        const ptr = bus::read16(cpu.pc);
        cpu.pc += 2;

        // emulate 6502 page boundary hardware bug
        const lo = bus::read(ptr);
        var hi_addr: ushort = void;
        if (ptr & 0x00FF) == 0x00FF {
            hi_addr = ptr & 0xFF00;
        } else {
            hi_addr = ptr + 1;
        }

        const hi = bus::read(hi_addr);

        operand.addr = (cast<ushort>(hi) << 8) | lo;
    case .IndirectX:
        const indir = bus::read(cpu.pc) + cpu.x;
        cpu.pc++;
        const lo = bus::read(cast<ushort>(indir));
        const hi = bus::read(cast<ushort>(indir + 1));
        operand.addr = (cast<ushort>(hi) << 8) | lo;
    case .IndirectY:
        const indir = bus::read(cpu.pc);
        cpu.pc++;
        const lo = bus::read(cast<ushort>(indir));
        const hi = bus::read(cast<ushort>(indir + 1));
        const base = (cast<ushort>(hi) << 8) | lo;
        operand.addr = base + cpu.y;
        operand.page_crossed = did_cross_page(base, operand.addr);
        operand.dummy_addr = (base & 0xFF00) | (operand.addr & 0x00FF);
    default:
        io::printf("Bad addressing mode.\n");
    }
    return operand;
}

fn did_cross_page(base: ushort, addr: ushort) bool
{
    return (base & 0xFF00) != (addr & 0xFF00);
}

fn dispatch_instruction(instr: *const Instr, operand: *Operand) void
{
    switch instr.kind {
    case .Invalid:
        io::printf("Bad instruction.");
    case .ADC:
        const val = operand.read();
        const result_full: ushort = cast<ushort>(cpu.a) + val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case .AND:
        cpu.a &= operand.read();
        set_nz(cpu.a);
    case .ASL:
        const val = operand.read();
        operand.write(val);
        const result = val << 1;
        operand.write(result);
        cpu.status.c = (val >> 7) != 0;
        set_nz(result);
    case .BCC:
        branch_if_cond(!cpu.status.c, operand);
    case .BCS:
        branch_if_cond(cpu.status.c, operand);
    case .BEQ:
        branch_if_cond(cpu.status.z, operand);
    case .BIT:
        const val = operand.read();
        const result = cpu.a & val;
        cpu.status.z = result == 0;
        cpu.status.n = (val & (1 << 7)) != 0;
        cpu.status.v = (val & (1 << 6)) != 0;
    case .BMI:
        branch_if_cond(cpu.status.n, operand);
    case .BNE:
        branch_if_cond(!cpu.status.z, operand);
    case .BPL:
        branch_if_cond(!cpu.status.n, operand);
    case .BRK:
        cpu.pc++;
        stack_push16(cpu.pc);
        stack_push(get_status(true));
        cpu.status.i = true;
        cpu.pc = bus::read16(0xFFFE);

    case .BVC:
        branch_if_cond(!cpu.status.v, operand);
    case .BVS:
        branch_if_cond(cpu.status.v, operand);
    case .CLC:
        cpu.status.c = false;
    case .CLD:
        cpu.status.d = false;
    case .CLI:
        cpu.status.i = false;
    case .CLV:
        cpu.status.v = false;
    case .CMP:
        compare_op(cpu.a, operand.read());
    case .CPX:
        compare_op(cpu.x, operand.read());
    case .CPY:
        compare_op(cpu.y, operand.read());
    case .DEC:
        const old = operand.read();
        operand.write(old);
        operand.write(old - 1);
        set_nz(old - 1);
    case .DEX:
        set_nz(--cpu.x);
    case .DEY:
        set_nz(--cpu.y);
    case .EOR:
        cpu.a = cpu.a ^ operand.read();
        set_nz(cpu.a);
    case .INC:
        const old = operand.read();
        operand.write(old);
        operand.write(old + 1);
        set_nz(old + 1);
    case .INX:
        set_nz(++cpu.x);
    case .INY:
        set_nz(++cpu.y);
    case .JMP:
        cpu.pc = operand.addr;
    case .JSR:
        stack_push16(cpu.pc - 1);
        cpu.pc = operand.addr;
    case .LDA:
        cpu.a = operand.read();
        set_nz(cpu.a);
    case .LDX:
        cpu.x = operand.read();
        set_nz(cpu.x);
    case .LDY:
        cpu.y = operand.read();
        set_nz(cpu.y);
    case .LSR:
        const val = operand.read();
        operand.write(val);
        const result = val >> 1;
        operand.write(result);
        cpu.status.c = (val & 1) != 0;
        cpu.status.n = false;
        cpu.status.z = result == 0;
    case .NOP:
        operand.read();
    case .ORA:
        cpu.a |= operand.read();
        set_nz(cpu.a);
    case .PHA:
        stack_push(cpu.a);
    case .PHP:
        stack_push(get_status(true));
    case .PLA:
        cpu.a = stack_pop();
        set_nz(cpu.a);
    case .PLP:
        pop_status();
    case .ROL:
        const val = operand.read();
        operand.write(val);
        const result = (val << 1) | cast<ubyte>(cpu.status.c);
        operand.write(result);
        cpu.status.c = (val & 0x80) != 0;
        set_nz(result);
    case .ROR:
        const val = operand.read();
        operand.write(val);
        const result = (val >> 1) | (cast<ubyte>(cpu.status.c) << 7);
        operand.write(result);
        cpu.status.c = (val & 0x1) != 0;
        set_nz(result);
    case .RTI:
        pop_status();
        cpu.pc = stack_pop16();
    case .RTS:
        cpu.pc = stack_pop16() + 1;
    case .SBC:
        const not_val = ~operand.read();
        const result_full: ushort = cast<ushort>(cpu.a) + not_val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ not_val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case .SEC:
        cpu.status.c = true;
    case .SED:
        cpu.status.d = true;
    case .SEI:
        cpu.status.i = true;
    case .STA:
        operand.write(cpu.a);
    case .STX:
        operand.write(cpu.x);
    case .STY:
        operand.write(cpu.y);
    case .TAX:
        cpu.x = cpu.a;
        set_nz(cpu.x);
    case .TAY:
        cpu.y = cpu.a;
        set_nz(cpu.y);
    case .TSX:
        cpu.x = cpu.sp;
        set_nz(cpu.x);
    case .TXA:
        cpu.a = cpu.x;
        set_nz(cpu.a);
    case .TXS:
        cpu.sp = cpu.x;
    case .TYA:
        cpu.a = cpu.y;
        set_nz(cpu.a);
    case .ALR:
        cpu.a &= operand.read();
        cpu.status.c = (cpu.a & 1) != 0;
        cpu.a >>= 1;
        set_nz(cpu.a);
    case .ANC:
        cpu.a &= operand.read();
        set_nz(cpu.a);
        cpu.status.c = cpu.status.n;
    case .ARR:
        var val = cpu.a & operand.read();

        val = (val >> 1) | (cast<ubyte>(cpu.status.c) << 7);

        cpu.a = val;

        set_nz(cpu.a);

        cpu.status.c = (cpu.a & 0x40) != 0;
        cpu.status.v = (((cpu.a >> 6) ^ (cpu.a >> 5)) & 1) == 1;
    case .AXS:
        const lhs = cpu.a & cpu.x;
        const rhs = operand.read();
        const result = lhs - rhs;
        cpu.status.c = lhs >= rhs;
        cpu.x = result;
        set_nz(cpu.x);
    case .DCP:
        const val = operand.read() - 1;
        bus::write(operand.addr, val);
        compare_op(cpu.a, val);
    case .ISB:
        const val = operand.read() + 1;
        bus::write(operand.addr, val);

        const not_val = ~val;
        const result_full: ushort = cast<ushort>(cpu.a) + not_val + cast<ushort>(cpu.status.c);
        const result = cast<ubyte>(result_full);
        cpu.status.c = result_full > 0xFF;
        cpu.status.v = ((result ^ cpu.a) & (result ^ not_val) & 0x80) != 0;
        cpu.a = result;
        set_nz(cpu.a);
    case .LAS:
        const val = operand.read() & cpu.sp;

        cpu.a = val;
        cpu.x = val;
        cpu.sp = val;

        set_nz(val);
    case .LAX:
        const val = operand.read();
        cpu.a = val;
        cpu.x = val;
        set_nz(val);
    case .RLA:
        var val = operand.read();

        const new_c = (val & 0x80) != 0;
        val = (val << 1) | cast<ubyte>(cpu.status.c);
        cpu.status.c = new_c;

        bus::write(operand.addr, val);

        cpu.a &= val;
        set_nz(cpu.a);
    case .RRA:
        const val = operand.read();
        const result = (val >> 1) | (cast<ubyte>(cpu.status.c) << 7);
        operand.write(result);
        const carry = val & 0x1;
        const adc_full: ushort = cast<ushort>(cpu.a) + result + carry;
        const adc = cast<ubyte>(adc_full);
        cpu.status.c = adc_full > 0xFF;
        cpu.status.v = ((adc ^ cpu.a) & (adc ^ result) & 0x80) != 0;
        cpu.a = adc;
        set_nz(cpu.a);
    case .SAX:
        const val = cpu.a & cpu.x;
        bus::write(operand.addr, val);
    case .SHX:
        const val = cpu.x & (cast<ubyte>(operand.addr >> 8) + 1);
        bus::write(if operand.page_crossed => (operand.addr & 0x00FF) | (cast<ushort>(val) << 8) else => operand.addr, val);
    case .SHY:
        const val = cpu.y & (cast<ubyte>(operand.addr >> 8) + 1);
        bus::write(if operand.page_crossed => (operand.addr & 0x00FF) | (cast<ushort>(val) << 8) else => operand.addr, val);
    case .SLO:
        var val = operand.read();
        cpu.status.c = (val & 0x80) != 0;

        val = val << 1;
        bus::write(operand.addr, val);

        cpu.a |= val;
        set_nz(cpu.a);
    case .SRE:
        var val = operand.read();
        cpu.status.c = (val & 0x01) != 0;

        val = val >> 1;
        bus::write(operand.addr, val);

        cpu.a ^= val;
        set_nz(cpu.a);
    case .TAS:
        cpu.sp = cpu.a & cpu.x;
        bus::write(operand.addr, cpu.sp & (cast<ubyte>(operand.addr >> 8) + 1));
    case .XAA:
        cpu.a = cpu.a & cpu.x & operand.read();
        set_nz(cpu.a);
    case .AHX:
        const val = cpu.a & cpu.x & (cast<ubyte>(operand.addr >> 8) + 1);
        bus::write(if operand.page_crossed => (operand.addr & 0x00FF) | (cast<ushort>(val) << 8) else => operand.addr, val);
    case .STP:
        cpu.halted = true;
    }
    if operand.page_crossed && instr.page_cross_penalty {
        cpu.current_cycles++;
    }

}

fn Operand.read(op: *const Operand) ubyte
{
    if op.addr_mode == AddrMode.Accumulator {
        return cpu.a;
    }
    else if op.page_crossed {
        bus::read(op.dummy_addr);
    }

    return bus::read(op.addr);
}

fn Operand.write(op: *const Operand, value: ubyte) void
{
    if op.addr_mode == AddrMode.Accumulator {
        cpu.a = value;
    } else {
        bus::read(op.dummy_addr);
        bus::write(op.addr, value);
    }
}

fn branch_if_cond(cond: bool, operand: *const Operand) void
{
    if cond {
        cpu.current_cycles += cast<ubyte>(did_cross_page(cpu.pc, operand.addr));
        cpu.pc = operand.addr;
        cpu.current_cycles++;
    }
}

fn compare_op(regval: ubyte, val: ubyte) void
{
    const result = regval - val;
    cpu.status.c = regval >= val;
    cpu.status.z = regval == val;
    cpu.status.n = (result >> 7) != 0;
}

fn set_nz(result: ubyte) void
{
    cpu.status.n = (result >> 7) != 0;
    cpu.status.z = result == 0;
}

fn stack_push(value: ubyte) void
{
    bus::write(0x0100 | cpu.sp, value);
    cpu.sp--;
}

fn stack_push16(value: ushort) void
{
    stack_push(value >> 8);
    stack_push(cast<ubyte>(value));
}

fn stack_pop() ubyte
{
    cpu.sp++;
    return bus::read(0x0100 | cpu.sp);
}

fn stack_pop16() ushort
{
    const lo = cast<ushort>(stack_pop());
    const hi = cast<ushort>(stack_pop());
    return (hi << 8) | lo;
}

fn pop_status() void
{
    const status = stack_pop();
    cpu.status.c = (status & (1 << 0)) != 0;
    cpu.status.z = (status & (1 << 1)) != 0;
    cpu.status.i = (status & (1 << 2)) != 0;
    cpu.status.d = (status & (1 << 3)) != 0;
    cpu.status.v = (status & (1 << 6)) != 0;
    cpu.status.n = (status & (1 << 7)) != 0;
}

fn get_status(break_flag: bool) ubyte
{
    return
        (cast<ubyte>(cpu.status.c) << 0) |
        (cast<ubyte>(cpu.status.z) << 1) |
        (cast<ubyte>(cpu.status.i) << 2) |
        (cast<ubyte>(cpu.status.d) << 3) |
        (cast<ubyte>(break_flag)   << 4) | // B is set to 1 for pushes, 0 for IRQ/NMI
        (1                         << 5) | // unused bit, usually set
        (cast<ubyte>(cpu.status.v) << 6) |
        (cast<ubyte>(cpu.status.n) << 7);
}

enum InstrKind : ubyte
{
    Invalid,
    // Official
    ADC,
    AND,
    ASL,
    BCC,
    BCS,
    BEQ,
    BIT,
    BMI,
    BNE,
    BPL,
    BRK,
    BVC,
    BVS,
    CLC,
    CLD,
    CLI,
    CLV,
    CMP,
    CPX,
    CPY,
    DEC,
    DEX,
    DEY,
    EOR,
    INC,
    INX,
    INY,
    JMP,
    JSR,
    LDA,
    LDX,
    LDY,
    LSR,
    NOP,
    ORA,
    PHA,
    PHP,
    PLA,
    PLP,
    ROL,
    ROR,
    RTI,
    RTS,
    SBC,
    SEC,
    SED,
    SEI,
    STA,
    STX,
    STY,
    TAX,
    TAY,
    TSX,
    TXA,
    TXS,
    TYA,

    // Unofficial / Illegal
    ALR,
    ANC,
    ARR,
    AXS,
    DCP,
    ISB,
    LAS,
    LAX,
    RLA,
    RRA,
    SAX,
    SHX,
    SHY,
    SLO,
    SRE,
    TAS,
    XAA,
    AHX,
    STP,
}

enum AddrMode : ubyte
{
    None,
    Implied,
    Accumulator,
    Immediate,
    ZeroPage,
    ZeroPageX,
    ZeroPageY,
    Absolute,
    AbsoluteX,
    AbsoluteY,
    Relative,
    Indirect,
    IndirectX,
    IndirectY,
}

const instr_kind_to_str: [#type_max(InstrKind) - #type_min(InstrKind) + 1]CString = [
    InstrKind.NOP: "NOP",
    InstrKind.ADC: "ADC",
    InstrKind.AND: "AND",
    InstrKind.ASL: "ASL",
    InstrKind.BCC: "BCC",
    InstrKind.BCS: "BCS",
    InstrKind.BEQ: "BEQ",
    InstrKind.BIT: "BIT",
    InstrKind.BMI: "BMI",
    InstrKind.BNE: "BNE",
    InstrKind.BPL: "BPL",
    InstrKind.BRK: "BRK",
    InstrKind.BVC: "BVC",
    InstrKind.BVS: "BVS",
    InstrKind.CLC: "CLC",
    InstrKind.CLD: "CLD",
    InstrKind.CLI: "CLI",
    InstrKind.CLV: "CLV",
    InstrKind.CMP: "CMP",
    InstrKind.CPX: "CPX",
    InstrKind.CPY: "CPY",
    InstrKind.DEC: "DEC",
    InstrKind.DEX: "DEX",
    InstrKind.DEY: "DEY",
    InstrKind.EOR: "EOR",
    InstrKind.INC: "INC",
    InstrKind.INX: "INX",
    InstrKind.INY: "INY",
    InstrKind.JMP: "JMP",
    InstrKind.JSR: "JSR",
    InstrKind.LDA: "LDA",
    InstrKind.LDX: "LDX",
    InstrKind.LDY: "LDY",
