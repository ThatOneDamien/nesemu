import CString;
import io;
import malloc;
import todo;
import context;

#const NES_CONSTANT: uint = 0x1A53454E;

pub struct CartHeader
{
    nes_constant: uint,
    prg_rom_size: ubyte,
    chr_rom_size: ubyte,
    flags6: ubyte,
    flags7: ubyte,
    flags8: ubyte,
    flags9: ubyte,
    flags10: ubyte,
    reserved: [5]ubyte,
}

pub struct NesCart
{
    header: *CartHeader,
    mapper_kind: MapperKind,
    mapper: Mapper,
    prg: []const ubyte,
    chr: []const ubyte,
}

pub struct Mapper
{
    cpu_read: fn (ushort) ubyte,
    cpu_write: fn (ushort, ubyte) void,
    ppu_read: fn (ushort) ubyte,
    ppu_write: fn(ushort, ubyte) void,
}

pub enum MapperKind : ubyte
{
    NROM,
}

pub fn NesCart.from_file(file_path: CString) ?NesCart
{
    const fd = io::open(file_path, io::O_RDONLY);
    if fd < 0 {
        io::fprintf(io::stderr, "Failed to open file %s\n", file_path);
        return null;
    }

    const sz = cast<usize>(io::lseek(fd, 0, io::SEEK_END));
    io::lseek(fd, 0, io::SEEK_SET);

    const header = cast<*CartHeader>(malloc(sz));
    io::read(fd, header, sz);
    io::close(fd);
    const prg_size = cast<uint>(header.prg_rom_size) * 0x4000;
    const chr_size = cast<uint>(header.chr_rom_size) * 0x2000;
    if header.nes_constant != NES_CONSTANT {
        io::printf("Rom \'%s\' was detected to be invalid.\n", file_path);
        return null;
    }

    const data = cast<*[*]ubyte>(header);
    var prg_offset: usize = #sizeof(CartHeader);
    // io::printf("offset: %lu\n", prg_offset);
    if (header.flags6 & 0x04) != 0 {
        prg_offset += 512;
    }
    const chr_offset = prg_offset + prg_size;
    const mapper_num = (header.flags7 & 0xF0) | (header.flags6 >> 4);
    // io::printf("Successfully loaded rom '%s' PRG_SIZE: %u  CHR_SIZE: %u\n", file_path, prg_size, chr_size);
    return NesCart {
        header: header,
        mapper_kind: cast<MapperKind>(mapper_num),
        mapper: mappers[mapper_num],
        prg: data[prg_offset..chr_offset],
        chr: data[chr_offset..chr_offset + chr_size],
    };
}

fn nrom_cpu_read(addr: ushort) ubyte
{
    if addr >= 0x8000 {
        var final: ushort = addr - 0x8000;
        if context.cart!.prg.len == 0x4000 {
            final &= 0x3FFF;
        }
        return context.cart!.prg[final];
    }

    todo(null);
    return 0;
}

fn nrom_ppu_read(addr: ushort) ubyte
{

}

const mappers: [#type_max(MapperKind) - #type_min(MapperKind) + 1]Mapper = [
    MapperKind.NROM: Mapper{ cpu_read: &nrom_cpu_read, },
];
