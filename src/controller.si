import context;
import sdl;
import io;

pub struct Controller
{
    state: ubyte, // current buttons
    shift: ubyte, // latched state being shifted out
    strobe: bool,
}

#const controller = &context.controller;

pub fn set_state() void
{
    var key_cnt: int = void;
    const keys = sdl::GetKeyboardState(&key_cnt);
    var new_state: ubyte = 0;
    if keys[sdl::Scancode.X]      { new_state |= 1 << 0; } // A
    if keys[sdl::Scancode.Z]      { new_state |= 1 << 1; } // B
    if keys[sdl::Scancode.RSHIFT] { new_state |= 1 << 2; } // Select
    if keys[sdl::Scancode.RETURN] { new_state |= 1 << 3; } // Start
    if keys[sdl::Scancode.UP]     { new_state |= 1 << 4; }
    if keys[sdl::Scancode.DOWN]   { new_state |= 1 << 5; }
    if keys[sdl::Scancode.LEFT]   { new_state |= 1 << 6; }
    if keys[sdl::Scancode.RIGHT]  { new_state |= 1 << 7; }
    controller.state = new_state;
}

pub fn read_4016() ubyte
{
    const ret = controller.shift & 1;
    controller.shift >>= 1;
    return ret;
}

pub fn write_4016(value: ubyte) void
{
    const new_strobe: bool = (value & 1) == 1;

    if (controller.strobe && !new_strobe) {
        controller.shift = controller.state;
    }

    controller.strobe = new_strobe;
}
