import CString;

pub #const O_RDONLY: int = 0;
pub #const SEEK_SET: int = 0;
pub #const SEEK_END: int = 2;

pub extern const stderr: *void;

pub extern fn fprintf(fp: *void, fmt: CString, ...) void;
pub extern fn printf(fmt: CString, ...) void;
pub extern fn open(path: CString, flags: int, ...) int;
pub extern fn close(fd: int) int;
pub extern fn read(fd: int, buf: *void, count: usize) isize;
pub extern fn lseek(fd: int, offset: isize, whence: int) isize;
pub extern fn memcpy(dst: *void, src: *const void, size: usize) *void;
pub extern fn memset(s: *void, val: ubyte, size: usize) *void;
