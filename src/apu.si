import io;
import context;

pub struct APU
{
    cpu_cycles: ulong,
    frame_mode: bool,
    frame_irq_inhibit: bool,
    frame_irq: bool,
    frame_step: ubyte,
    frame_counter: uint,
    dmc_irq: bool,

    pulse1: PulseChannel,
    pulse2: PulseChannel,
    // triangle: TriangleChannel,
    // noise: NoiseChannel,
    // dmc: DMCChannel,
}

pub struct PulseChannel
{
    enabled: bool,
    halted: bool,
    timer: ushort,
    reload: ushort,
    seq_step: ubyte,
    duty: ubyte,
    output: ubyte,

    env: Envelope,
    length_counter: ubyte,
    sweep: Sweep,
}

pub struct Envelope
{
    start: bool,
    loop: bool,
    constant: bool,

    divider: ubyte,
    period: ubyte,

    decay: ubyte,
}

pub struct Sweep
{
    enabled: bool,
    negate: bool,
    reload: bool,

    period: ubyte,
    shift: ubyte,

    divider: ubyte,
    mute: bool,
}

#const apu: *APU = &context.apu;
const length_table: [*]ubyte = [   10, 254, 20,  2, 40,  4, 80,  6,
							      160,   8, 60, 10, 14, 12, 26, 14,
							       12,  16, 24, 18, 48, 20, 96, 22,
							      192,  24, 72, 26, 16, 28, 32, 30 ];

const duty_table: [4]ubyte = [
    0b0000_0001,
    0b0000_0011,
    0b0000_1111,
    0b1111_1001,
];


pub fn clock() void
{
    apu.cpu_cycles++;

    // Pulse timers run every other CPU cycle
    if (apu.cpu_cycles & 1) == 0
    {
        apu.pulse1.timer_clock();
        apu.pulse2.timer_clock();
    }

    // Advance frame sequencer
    apu.frame_counter++;

    if !apu.frame_mode
    {
        // -----------------------
        // 4-step sequence
        // -----------------------

        switch apu.frame_counter
        {
        case 3729:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();
        case 7457:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();

            apu.pulse1.length_counter_clock();
            apu.pulse2.length_counter_clock();

            apu.pulse1.sweep_clock(true);
            apu.pulse2.sweep_clock(false);

        case 11186:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();

        case 14915:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();

            apu.pulse1.length_counter_clock();
            apu.pulse2.length_counter_clock();

            apu.pulse1.sweep_clock(true);
            apu.pulse2.sweep_clock(false);

            if !apu.frame_irq_inhibit
            {
                apu.frame_irq = true;
            }

            apu.frame_counter = 0;
        }
    }
    else
    {
        // -----------------------
        // 5-step sequence
        // -----------------------

        switch apu.frame_counter
        {
        case 3729:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();
        case 7457:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();

            apu.pulse1.length_counter_clock();
            apu.pulse2.length_counter_clock();

            apu.pulse1.sweep_clock(true);
            apu.pulse2.sweep_clock(false);
        case 11186:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();
        case 18641:
            apu.pulse1.env.clock();
            apu.pulse2.env.clock();

            apu.pulse1.length_counter_clock();
            apu.pulse2.length_counter_clock();

            apu.pulse1.sweep_clock(true);
            apu.pulse2.sweep_clock(false);

            apu.frame_counter = 0;
        }
    }
}

pub fn read_status() ubyte
{
    var status: ubyte = 0;

    if apu.pulse1.length_counter > 0 {
        status |= 0x01;
    }

    if apu.pulse2.length_counter > 0 {
        status |= 0x02;
    }

    // if apu.triangle.length_counter > 0 {
    //     status |= 0x04;
    // }
    //
    // if apu.noise.length_counter > 0 {
    //     status |= 0x08;
    // }
    //
    // if apu.dmc.bytes_remaining > 0 {
    //     status |= 0x10;
    // }

    if apu.frame_irq {
        status |= 0x40;
    }

    if apu.dmc_irq {
        status |= 0x80;
    }

    // Reading $4015 acknowledges the frame IRQ.
    apu.frame_irq = false;

    return status;
}

pub fn write(addr: ushort, value: ubyte) void
{
    const reg = addr & 0x001F;

    switch reg
    {
    case 0x00:
        apu.pulse1.duty = (value >> 6) & 0x03;
        apu.pulse1.env.constant = (value & 0x10) != 0;
        apu.pulse1.env.loop = (value & 0x20) != 0;
        apu.pulse1.halted = (value & 0x20) != 0;
        apu.pulse1.env.period = value & 0x0F;
        break;

    case 0x01:
        apu.pulse1.sweep.enabled = (value & 0x80) != 0;
        apu.pulse1.sweep.period  = (value >> 4) & 0x07;
        apu.pulse1.sweep.negate  = (value & 0x08) != 0;
        apu.pulse1.sweep.shift   = value & 0x07;
        apu.pulse1.sweep.reload  = true;
        break;

    case 0x02:
        apu.pulse1.timer = (apu.pulse1.timer & 0xFF00) | value;
        break;

    case 0x03:
        apu.pulse1.timer = (apu.pulse1.timer & 0x00FF) | (cast<ushort>(value & 0x07) << 8);
        apu.pulse1.seq_step = 0;
        apu.pulse1.length_counter = length_table[(value >> 3) & 0x1F];
        apu.pulse1.env.start = true;
        break;

    // -------------------
    // PULSE 2 (same pattern)
    // -------------------
    case 0x04:
        apu.pulse2.duty = (value >> 6) & 0x03;
        apu.pulse2.env.constant = (value & 0x10) != 0;
        apu.pulse2.env.loop = (value & 0x20) != 0;
        apu.pulse2.halted = (value & 0x20) != 0;
        apu.pulse2.env.period = value & 0x0F;
        break;

    case 0x05:
        apu.pulse2.sweep.enabled = (value & 0x80) != 0;
        apu.pulse2.sweep.period  = (value >> 4) & 0x07;
        apu.pulse2.sweep.negate  = (value & 0x08) != 0;
        apu.pulse2.sweep.shift   = value & 0x07;
        apu.pulse2.sweep.reload  = true;
        break;

    case 0x06:
        apu.pulse2.timer = (apu.pulse2.timer & 0xFF00) | value;
        break;

    case 0x07:
        apu.pulse2.timer = (apu.pulse2.timer & 0x00FF) | (cast<ushort>(value & 0x07) << 8);
        apu.pulse2.seq_step = 0;
        apu.pulse2.length_counter = length_table[(value >> 3) & 0x1F];
        apu.pulse2.env.start = true;
        break;

    // -------------------
    // STATUS ($4015)
    // -------------------
    case 0x15:
        apu.pulse1.enabled = (value & 0x01) != 0;
        apu.pulse2.enabled = (value & 0x02) != 0;

        // IMPORTANT: writing 0 clears length counters
        if !apu.pulse1.enabled { apu.pulse1.length_counter = 0; }
        if !apu.pulse2.enabled { apu.pulse2.length_counter = 0; }

        break;

    // -------------------
    // FRAME COUNTER ($4017)
    // -------------------
    case 0x17:
        // mode + irq inhibit
        apu.frame_irq_inhibit = (value & 0x40) != 0;
        apu.frame_mode = ((value >> 7) & 1) == 1;

        if apu.frame_mode {
            // 5-step mode: immediately clock envelopes twice (important quirk)
            apu.pulse1.env.clock();
            apu.pulse1.env.clock();
        }
        break;

    default:
        break;
    }
}

fn PulseChannel.clock(p: *PulseChannel) void
{
    if !p.enabled {
        p.output = 0;
        return;
    }

    // timer counts down
    if p.timer == 0 {
        p.timer = p.reload;
        p.seq_step = (p.seq_step + 1) & 7;
    } else {
        p.timer--;
    }

    const wave = duty_table[p.duty] & (cast<ubyte>(1) << p.seq_step);

    if wave != 0 {
        p.output = p.env.volume();
    } else {
        p.output = 0;
    }

}

fn Envelope.volume(env: *const Envelope) ubyte
{
    if env.constant {
        return env.period; // fixed volume mode
    }
    return env.decay;
}

fn Envelope.clock(env: *Envelope) void
{
    if env.start
    {
        env.start = false;
        env.decay = 15;
        env.divider = env.period;
        return;
    }

    if env.divider == 0
    {
        env.divider = env.period;

        if env.decay == 0
        {
            if env.loop {
                env.decay = 15;
            }
        }
        else
        {
            env.decay -= 1;
        }
    }
    else
    {
        env.divider -= 1;
    }
}

pub fn PulseChannel.length_counter_clock(channel: *PulseChannel) void
{
    if channel.length_counter > 0 && !channel.env.loop
    {
        channel.length_counter--;
    }
}

fn PulseChannel.sweep_target_period(channel: *PulseChannel, is_pulse1: bool) ushort
{
    const change = channel.reload >> channel.sweep.shift;

    if channel.sweep.negate
    {
        if is_pulse1
        {
            return channel.reload - change - 1;
        }

        return channel.reload - change;
    }

    return channel.reload + change;
}

pub fn PulseChannel.sweep_clock(channel: *PulseChannel, is_pulse1: bool) void
{
    if channel.sweep.divider == 0
    {
        if channel.sweep.enabled &&
           channel.sweep.shift != 0 &&
           !channel.sweep.mute
        {
            channel.reload = channel.sweep_target_period(is_pulse1);
        }

        channel.sweep.divider = channel.sweep.period;
    }
    else
    {
        channel.sweep.divider--;
    }

    if channel.sweep.reload
    {
        channel.sweep.reload = false;
        channel.sweep.divider = channel.sweep.period;
    }

    const target = channel.sweep_target_period(is_pulse1);

    channel.sweep.mute =
        channel.reload < 8 ||
        target > 0x7FF;
}

pub fn PulseChannel.timer_clock(channel: *PulseChannel) void
{
    if channel.timer > 0
    {
        channel.timer--;
    }
    else
    {
        channel.timer = channel.reload;
        channel.seq_step = (channel.seq_step + 1) & 7;
    }
}
