import io;
import context;

pub struct APU
{
    cpu_cycles: ulong,
    frame_irq: bool,
    dmc_irq: bool,

    pulse1: PulseChannel,
    pulse2: PulseChannel,
    triangle: TriangleChannel,
    noise: NoiseChannel,
    dmc: DMCChannel,
}

pub struct PulseChannel
{
    enabled: bool,
    halted: bool,
    sample: double,
    output: double,

    seq: Sequencer,
    osc: OscPulse,
    env: Envelope,
    length_counter: ubyte,
    sweep: Sweeper,
}

pub struct TriangleChannel
{
    enabled: bool,
    timer: ushort,
    reload: ushort,
    step: ubyte,
    length_counter: ubyte,
    linear_counter: ubyte
}

pub struct NoiseChannel
{
    enabled: bool,
    halted: bool,
    seq: Sequencer,
    shift_register: ushort,
    mode: bool,
    env: Envelope,
    length_counter: ubyte,
}

pub struct DMCChannel
{
    enabled: bool,
    irq_enable: bool,
    loop: bool,
    sample_address: ushort,
    current_address: ushort,
    sample_length: ushort,
    bytes_remaining: ushort,
    shift_register: ubyte,
    bits_remaining: ubyte,
    output_level: ubyte,
    timer: ushort,
    reload: ushort,
    irq: bool
}

pub struct Envelope
{
    start: bool,
    disable: bool,
    divider_count: ushort,
    volume: ushort,
    output: ushort,
    decay_count: ushort,
}

pub struct Sequencer
{
    sequence: ubyte,
    new_sequence: ubyte,
    timer: ushort,
    reload: ushort,
    output: ubyte,
}

pub struct OscPulse
{
    frequency: double,
    dutycycle: double,
    amplitude: double,
}

pub struct Sweeper
{
    enabled: bool,
    down: bool,
    reload: bool,
    shift: ubyte,
    timer: ubyte,
    period: ubyte,
    change: ushort,
    mute: bool,
}

#const apu: *APU = &context.apu;
const length_table: [*]ubyte = [   10, 254, 20,  2, 40,  4, 80,  6,
							      160,   8, 60, 10, 14, 12, 26, 14,
							       12,  16, 24, 18, 48, 20, 96, 22,
							      192,  24, 72, 26, 16, 28, 32, 30 ];


pub fn clock() void
{

}

pub fn read_status() ubyte
{
    var status: ubyte = 0;

    if apu.pulse1.length_counter > 0 {
        status |= 0x01;
    }

    if apu.pulse2.length_counter > 0 {
        status |= 0x02;
    }

    if apu.triangle.length_counter > 0 {
        status |= 0x04;
    }

    if apu.noise.length_counter > 0 {
        status |= 0x08;
    }

    if apu.dmc.bytes_remaining > 0 {
        status |= 0x10;
    }

    if apu.frame_irq {
        status |= 0x40;
    }

    if apu.dmc_irq {
        status |= 0x80;
    }

    // Reading $4015 acknowledges the frame IRQ.
    apu.frame_irq = false;

    return status;
}

pub fn write(addr: ushort, value: ubyte) void
{
	switch addr
	{
	case 0x0:
		switch ((value & 0xC0) >> 6)
		{
		case 0x00: apu.pulse1.seq.new_sequence = 0b01000000; apu.pulse1.osc.dutycycle = 0.125; break;
		case 0x01: apu.pulse1.seq.new_sequence = 0b01100000; apu.pulse1.osc.dutycycle = 0.250; break;
		case 0x02: apu.pulse1.seq.new_sequence = 0b01111000; apu.pulse1.osc.dutycycle = 0.500; break;
		case 0x03: apu.pulse1.seq.new_sequence = 0b10011111; apu.pulse1.osc.dutycycle = 0.750; break;
		}
		apu.pulse1.seq.sequence = apu.pulse1.seq.new_sequence;
		apu.pulse1.halted = (value & 0x20) == 0x20;
		apu.pulse1.env.volume = (value & 0x0F);
		apu.pulse1.env.disable = (value & 0x10) == 0x10;
		break;

	case 0x1:
		apu.pulse1.sweep.enabled = (value & 0x80) == 0x80;
		apu.pulse1.sweep.period = (value & 0x70) >> 4;
		apu.pulse1.sweep.down = (value & 0x08) == 0x08;
		apu.pulse1.sweep.shift = value & 0x07;
		apu.pulse1.sweep.reload = true;
		break;

	case 0x2:
		apu.pulse1.seq.reload = (apu.pulse1.seq.reload & 0xFF00) | value;
		break;

	case 0x3:
		apu.pulse1.seq.reload = cast<ushort>((value & 0x07)) << 8 | (apu.pulse1.seq.reload & 0x00FF);
		apu.pulse1.seq.timer = apu.pulse1.seq.reload;
		apu.pulse1.seq.sequence = apu.pulse1.seq.new_sequence;
		apu.pulse1.length_counter = length_table[(value & 0xF8) >> 3];
		apu.pulse1.env.start = true;
		break;

	case 0x4:
		switch ((value & 0xC0) >> 6)
		{
		case 0x00: apu.pulse2.seq.new_sequence = 0b01000000; apu.pulse2.osc.dutycycle = 0.125; break;
		case 0x01: apu.pulse2.seq.new_sequence = 0b01100000; apu.pulse2.osc.dutycycle = 0.250; break;
		case 0x02: apu.pulse2.seq.new_sequence = 0b01111000; apu.pulse2.osc.dutycycle = 0.500; break;
		case 0x03: apu.pulse2.seq.new_sequence = 0b10011111; apu.pulse2.osc.dutycycle = 0.750; break;
		}
		apu.pulse2.seq.sequence = apu.pulse2.seq.new_sequence;
		apu.pulse2.halted = (value & 0x20) == 0x20;
		apu.pulse2.env.volume = (value & 0x0F);
		apu.pulse2.env.disable = (value & 0x10) == 0x10;
		break;

	case 0x5:
		apu.pulse2.sweep.enabled = (value & 0x80) == 0x80;
		apu.pulse2.sweep.period = (value & 0x70) >> 4;
		apu.pulse2.sweep.down = (value & 0x08) == 0x08;
		apu.pulse2.sweep.shift = value & 0x07;
		apu.pulse2.sweep.reload = true;
		break;

	case 0x6:
		apu.pulse2.seq.reload = (apu.pulse2.seq.reload & 0xFF00) | value;
		break;

	case 0x7:
		apu.pulse2.seq.reload = cast<ushort>((value & 0x07)) << 8 | (apu.pulse2.seq.reload & 0x00FF);
		apu.pulse2.seq.timer = apu.pulse2.seq.reload;
		apu.pulse2.seq.sequence = apu.pulse2.seq.new_sequence;
		apu.pulse2.length_counter = length_table[(value & 0xF8) >> 3];
		apu.pulse2.env.start = true;
		
		break;

	case 0x8:
		break;

	case 0xC:
		apu.noise.env.volume = (value & 0x0F);
		apu.noise.env.disable = (value & 0x10) == 0x10;
		apu.noise.halted = (value & 0x20) == 0x20;
		break;

	case 0xE:
		switch (value & 0x0F)
		{
		case 0x00: apu.noise.seq.reload = 0; break;
		case 0x01: apu.noise.seq.reload = 4; break;
		case 0x02: apu.noise.seq.reload = 8; break;
		case 0x03: apu.noise.seq.reload = 16; break;
		case 0x04: apu.noise.seq.reload = 32; break;
		case 0x05: apu.noise.seq.reload = 64; break;
		case 0x06: apu.noise.seq.reload = 96; break;
		case 0x07: apu.noise.seq.reload = 128; break;
		case 0x08: apu.noise.seq.reload = 160; break;
		case 0x09: apu.noise.seq.reload = 202; break;
		case 0x0A: apu.noise.seq.reload = 254; break;
		case 0x0B: apu.noise.seq.reload = 380; break;
		case 0x0C: apu.noise.seq.reload = 508; break;
		case 0x0D: apu.noise.seq.reload = 1016; break;
		case 0x0E: apu.noise.seq.reload = 2034; break;
		case 0x0F: apu.noise.seq.reload = 4068; break;
		}
		break;
	case 0xF:
		apu.pulse1.env.start = true;
		apu.pulse2.env.start = true;
		apu.noise.env.start = true;
		apu.noise.length_counter = length_table[(value & 0xF8) >> 3];
		break;

	case 0x15: // APU STATUS
		apu.pulse1.enabled = (value & 0x01) == 0x01;
		apu.pulse2.enabled = (value & 0x02) == 0x02;
		apu.noise.enabled = (value & 0x04) == 0x04;
		break;

	}
}
