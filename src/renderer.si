import sdl;
import context;
import io;

pub struct Renderer
{
    framebuffer: [240][256]ubyte,
    sdl_ref: ?*sdl::Renderer,
    sdl_texture: ?*sdl::Texture,
}

#const renderer = &context.renderer;

pub fn init(window: *sdl::Window) void
{
    renderer.sdl_ref = sdl::CreateRenderer(window, null);
    if renderer.sdl_ref == null {
        io::printf("CreateRenderer failed: %s\n", sdl::GetError());
        sdl::Quit();
        return;
    }

    renderer.sdl_texture = sdl::CreateTexture(renderer.sdl_ref!, sdl::PixelFormat.RGBA32, sdl::TextureAccess.STREAMING, 256, 240);
    if renderer.sdl_texture == null {
        io::printf("CreateTexture failed: %s\n", sdl::GetError());
        sdl::Quit();
        return;
    }

}

pub fn render_scanline(scanline: ushort) void
{
    // Only visible area
    if scanline >= 240 {
        return;
    }

    const tile_y = scanline / 8;
    const row_in_tile = scanline % 8;

    for tile_x in 0..32 {

        const nametable_index = tile_y * 32 + tile_x;
        const tile_id = context.ppu.vram[nametable_index & 0x0FFF];

        var pattern_base: ushort = void;
        if (context.ppu.ctrl & 0x10) != 0 {
            pattern_base = 0x1000;
        } else {
            pattern_base = 0x0000;
        }

        const tile_addr =
            pattern_base + cast<ushort>(tile_id) * 16;

        const low  = context.rom!.chr[tile_addr + row_in_tile];
        const high = context.rom!.chr[tile_addr + row_in_tile + 8];

        for col in 0..8 {

            const bit0 = (low  >> cast<ubyte>(7 - col)) & 1;
            const bit1 = (high >> cast<ubyte>(7 - col)) & 1;

            const pixel = bit0 | (bit1 << 1);

            var color: ubyte = 0;
            switch pixel {
                case 0: color = 0;
                case 1: color = 85;
                case 2: color = 170;
                case 3: color = 255;
            }

            const screen_x = tile_x * 8 + col;
            const screen_y = scanline;

            renderer.framebuffer[screen_y][screen_x] = color;
        }
    }
}
pub fn present_frame() void
{
    var pixels: *void;
    var pitch: int;

    sdl::LockTexture(renderer.sdl_texture!, null, &pixels, &pitch);

    for y in 0..renderer.framebuffer.len {

        const row = cast<*[renderer.framebuffer[0].len]uint>(cast<uptr>(pixels) + (y * cast<usize>(pitch)));

        for x in 0..renderer.framebuffer[y].len {
            row[x] = renderer.framebuffer[y][x];
        }
    }

    sdl::UnlockTexture(renderer.sdl_texture!);
    sdl::RenderClear(renderer.sdl_ref!);
    sdl::RenderTexture(renderer.sdl_ref!, renderer.sdl_texture!, null, null);
    sdl::RenderPresent(renderer.sdl_ref!);
}
