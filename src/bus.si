import cpu;
import io;
import context;
import main;

pub fn read(addr: ushort) ubyte
{
    if addr >= 0x8000 {
    
        const rom_addr = addr - 0x8000;

        // mirror if only 16KB PRG
        if context.rom!.prg_rom.len == 0x4000 {
            return context.rom!.prg_rom[rom_addr & 0x3FFF];
        }

        return context.rom!.prg_rom[rom_addr];
    }
    return context.ram[addr];
}

pub fn read16(addr: ushort) ushort
{
    return *cast<*ushort>(&context.ram[addr]);
}

pub fn write(addr: ushort, value: ubyte) void
{
    context.ram[addr] = value;
}
