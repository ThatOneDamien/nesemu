import apu;
import cpu;
import ppu;
import io;
import context;
import todo;
import sdl;

pub struct Bus
{
    controllers: [2]Controller,

	system_clock: uint,
	dma_page: ubyte,
	dma_addr: ubyte,
	dma_data: ubyte,
	dma_dummy: bool,
	dma_transfer: bool,
    open_bus: ubyte,
}

pub struct Controller
{
    state: ubyte, // current buttons
    shift: ubyte, // latched state being shifted out
    strobe: bool,
}

#const bus = &context.bus;

pub fn power() void
{
	bus.system_clock = 0;
	bus.dma_page = 0x00;
	bus.dma_addr = 0x00;
	bus.dma_data = 0x00;
	bus.dma_dummy = true;
	bus.dma_transfer = false;
}

pub fn clock() void
{
    ppu::clock();

    if bus.system_clock % 3 == 0 
    {
        if bus.dma_transfer 
        {
            if bus.dma_dummy 
            {
				if bus.system_clock % 2 == 1 
                {
					bus.dma_dummy = false;
				}
            }
            else 
            {
				if (bus.system_clock % 2 == 0)
				{
					bus.dma_data = read(cast<ushort>(bus.dma_page) << 8 | bus.dma_addr);
				}
				else
				{
					ppu::oam_ptr[bus.dma_addr] = bus.dma_data;
					bus.dma_addr++;
					if (bus.dma_addr == 0x00)
					{
						bus.dma_transfer = false;
						bus.dma_dummy = true;
					}
				}

            }
            apu::clock();
        }
        else 
        {
            apu::clock();
            cpu::clock();
        }
    }


    bus.system_clock++;
}


pub fn read(addr: ushort) ubyte
{
    var value: ubyte = bus.open_bus;
    if !context.cart!.mapper.cpu_read(addr, &value) {
        value = 
        // 2KB RAM mirrored
        if addr < 0x2000 => context.ram[addr & 0x7FF]
        // PPU registers mirrored every 8 bytes 
        else if addr < 0x4000 => ppu::read_register(addr & 0x7)
        else if addr == 0x4015 => apu::read_status()
        else if addr == 0x4016 {
            const ret = (bus.open_bus & 0xE0) | (bus.controllers[0].shift & 1);
            bus.controllers[0].shift >>= 1;
            => ret;
        }
        else if addr == 0x4017 {
            const ret = (bus.open_bus & 0xE0) | bus.controllers[1].shift & 1;
            bus.controllers[1].shift >>= 1;
            => ret;
        }
        else => bus.open_bus;
    }

    bus.open_bus = value;
    return value;
}

pub fn read16(addr: ushort) ushort
{
    const lo = read(addr);
    const hi = read(addr + 1);
    return (cast<ushort>(hi) << 8) | lo;
}

pub fn write(addr: ushort, value: ubyte) void
{
    bus.open_bus = value;

    // 2KB RAM mirrored
    if addr < 0x2000 {
        context.ram[addr & 0x7FF] = value;
        return;
    }

    // PPU registers mirrored every 8 bytes
    if addr < 0x4000 {
        ppu::write_register(addr & 0x7, value);
        return;
    }

    if addr == 0x4014 {
		bus.dma_page = value;
		bus.dma_addr = 0x00;
		bus.dma_transfer = true;						
        return;
    }

    if addr == 0x4016 {
        const new_strobe: bool = (value & 1) == 1;

        if (bus.controllers[0].strobe && !new_strobe) {
            bus.controllers[0].shift = bus.controllers[0].state;
        }

        bus.controllers[0].strobe = new_strobe;
        return;
    }

    if addr <= 0x4017 {
        apu::write(addr & 0x1F, value);
        return;
    }

    if addr < 0x4020 {
        return;
    }


    context.cart!.mapper.cpu_write(addr, value);
}
