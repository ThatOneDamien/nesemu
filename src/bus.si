import cpu;
import ppu;
import io;
import context;
import todo;
import controller;

@nodiscard
pub fn read(addr: ushort) ubyte
{
    // 2KB RAM mirrored
    if addr < 0x2000 {
        return context.ram[addr & 0x7FF];
    }

    // PPU registers mirrored every 8 bytes
    if addr < 0x4000 {
        return ppu::read_register(addr & 0x7);
    }

    if addr == 0x4016 {
        return controller::read_4016();
    }
        // APU + IO
    if addr < 0x4020 {
        return 0;
    }
    
    return context.cart!.mapper.cpu_read(addr);
}

@nodiscard
pub fn read16(addr: ushort) ushort
{
    return (cast<ushort>(read(addr + 1)) << 8) | read(addr);
}

pub fn write(addr: ushort, value: ubyte) void
{
    
    // 2KB RAM mirrored
    if addr < 0x2000 {
        context.ram[addr & 0x7FF] = value;
        return;
    }

    // PPU registers mirrored every 8 bytes
    if addr < 0x4000 {
        ppu::write_register(addr & 0x7, value);
        return;
    }

    if addr == 0x4014 {
        ppu::oam_dma(value);
        return;
    }

    if addr == 0x4016 {
        controller::write_4016(value);
        return;
    }

        // APU + IO
    if addr < 0x4020 {
        return;
    }

    io::printf("Attempted to write to prg rom.");
}
