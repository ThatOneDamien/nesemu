pub mod sdl;
pub mod cpu;
pub mod ppu;
pub mod io;
pub mod bus;
pub mod rom;
pub mod renderer;

import rom::NesROM;

pub typedef CString = *[*]const char;
pub extern fn malloc(size: usize) *void;

pub var context: EmuContext;
pub var window: ?*sdl::Window;

pub struct EmuContext
{
    cpu: cpu::CPU,
    ppu: ppu::PPU,
    ram: [0x800]ubyte,
    rom: ?NesROM,
    renderer: renderer::Renderer,
}

pub fn todo(name: ?CString) void
{
    if name == null { name = "Not yet implemented."; }
    io::printf("TODO: %s\n", name);
}

fn main(args: []CString) int
{
    if args.len < 2 {
        io::printf("Usage: %s [ROM path]\n", args[0]);
        return 0;
    }
    context.rom = NesROM.from_file(args[1]);
    if context.rom == null { return 1; }
    cpu::reset();
    cpu::set_debug_entry(0xC000);
    for _i in 0..70 {
        const cycles = cpu::step();
        for i in 0..cast<usize>(cycles)*3 {
            ppu::tick();
        }
        cpu::check_nmi();
    }

    if !start_window_loop() {
        return 1;
    }
    return 0;
}

fn start_window_loop() bool 
{
    if(!sdl::Init(sdl::INIT_VIDEO))
	{
		io::printf("Failed to initialize SDL: %s", sdl::GetError());
		return false;
	}
    
    window = sdl::CreateWindow("My Bum Ah Nes Emulator", 800, 600, 0);
    if (window == null) {
        io::printf("CreateWindow failed: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    renderer::init(window!);

    var running = true;
    var event: sdl::Event;

    while (running) {
        while (sdl::PollEvent(&event)) {
            if (event.type == sdl::EVENT_QUIT) {
                running = false;
            }
        }

        // sdl::SetRenderDrawColor(renderer, 0, 12, 59, 255);
        // sdl::RenderClear(renderer);
        //
        // sdl::RenderPresent(renderer);

        sdl::Delay(16); // ~60 FPS idle loop
    }

    sdl::DestroyWindow(window!);
    sdl::Quit();
    return true;
}
