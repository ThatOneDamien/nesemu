import cart::NesCart;

pub typedef CString = *[*]const char;
pub extern fn malloc(size: usize) *void;

pub var context = EmuContext {
    ppu: ppu::PPU{
        system_palette: [
            0xFF626262, 0xFFB21F00, 0xFFC80424, 0xFFB20052,
            0xFF760073, 0xFF240080, 0xFF000B73, 0xFF002852,
            0xFF004424, 0xFF005700, 0xFF005C00, 0xFF245300,
            0xFF763C00, 0xFF000000, 0xFF000000, 0xFF000000,

            0xFFABABAB, 0xFFFF570D, 0xFFFF304B, 0xFFFF138A,
            0xFFD608BC, 0xFF6912D2, 0xFF002EC7, 0xFF00549D,
            0xFF007B5C, 0xFF009820, 0xFF00A300, 0xFF4B9100,
            0xFFB07700, 0xFF111111, 0xFF000000, 0xFF000000,

            0xFFFFFFFF, 0xFFFFAE53, 0xFFFF8590, 0xFFFF65D3,
            0xFFFF57FF, 0xFFCF5DFF, 0xFF5777FF, 0xFF009EFA,
            0xFF00C7BD, 0xFF00E77A, 0xFF11F643, 0xFF7EEF26,
            0xFFF6D52C, 0xFF4B4B4B, 0xFF000000, 0xFF000000,

            0xFFFFFFFF, 0xFFFFE1B6, 0xFFFFD1CE, 0xFFFFC3E9,
            0xFFFFBCFF, 0xFFF4BDFF, 0xFFC3C6FF, 0xFF9AD5FF,
            0xFF7ADFE9, 0xFF6BF3C7, 0xFFB2FFB3, 0xFFCCFFA9,
            0xFFFBFFFF, 0xFFB8B8B8, 0xFF000000, 0xFF000000,
        ]
    },
};
pub #const WINDOW_W: uint = 256;
pub #const WINDOW_H: uint = 240;
pub #const WINDOW_SCALE: uint = 3;
#const NS_PER_FRAME: ulong = 16589269;

pub struct EmuContext
{
    apu: apu::APU,
    cpu: cpu::CPU,
    ppu: ppu::PPU,
    bus: bus::Bus,
    ram: [0x800]ubyte,
    cart: ?NesCart,
    renderer: renderer::Renderer,
    audio_player: audio::Player,
    window: ?*sdl::Window,
    running: bool,
}

pub fn todo(name: ?CString) void
{
    if name == null { name = "Not yet implemented."; }
    io::printf("TODO: %s\n", name);
}

fn main(args: []CString) int
{
    if args.len < 2 {
        io::printf("Usage: %s [ROM path]\n", args[0]);
        return 0;
    }

    if(!sdl::Init(.INIT_VIDEO | .INIT_AUDIO))
	{
		io::printf("Failed to initialize SDL: %s", sdl::GetError());
		return 1;
	}
    
    if(!create_window()) {
        return 1;
    }

    context.cart = NesCart.from_file(args[1]);
    if context.cart == null { return 1; }

    if !renderer::init(context.window!) || !audio::init(44100) {
        return 1;
    }
    
    power_on();

    context.running = true;
    const freq = sdl::GetPerformanceFrequency();
    const freq_ns: double = freq / 1000000000.0;

    var prev_fps_calc = sdl::GetPerformanceCounter();
    var prev_frame = prev_fps_calc;
    var frames: uint = 0;

    while context.running {
        bus::clock();
        if context.ppu.frame_ready {
            process_events();
            set_controller_state();
            renderer::present_frame();
            context.ppu.frame_ready = false;
            const next_frame = sdl::GetPerformanceCounter();
            const delta = (next_frame - prev_frame) / freq_ns;
            if delta < NS_PER_FRAME {
                sdl::DelayNS(NS_PER_FRAME - cast<ulong>(delta));
                prev_frame = sdl::GetPerformanceCounter();
            } else {
                prev_frame = next_frame;
            }
            frames++;
        }
        const next_frame = sdl::GetPerformanceCounter();
        if ((next_frame - prev_fps_calc) / freq) >= 1 {
            io::printf("FPS: %3u  CPU_HZ: %7lu PPU_HZ: %7lu APU_HZ: %7lu SAMPLES: %5lu\n", 
                    frames, 
                    context.cpu.debug_cycles, 
                    context.ppu.debug_cycles, 
                    context.apu.debug_cycles,
                    context.apu.debug_samples);
            context.cpu.debug_cycles = 0;
            context.ppu.debug_cycles = 0;
            context.apu.debug_cycles = 0;
            context.apu.debug_samples = 0;
            prev_fps_calc = next_frame;
            frames = 0;
        }

    }

    sdl::DestroyWindow(context.window!);
    sdl::Quit();
    return 0;
}

fn power_on() void
{
    bus::power();
    cpu::power();
    ppu::power();
    apu::power();
}

fn create_window() bool 
{
    context.window = sdl::CreateWindow("Nes Emulator", cast<int>(WINDOW_W * WINDOW_SCALE), cast<int>(WINDOW_H * WINDOW_SCALE), 0);
    if (context.window == null) {
        io::printf("CreateWindow failed: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    return true;
}

fn process_events() void 
{
    var event: sdl::Event;

    while sdl::PollEvent(&event) {
        if event.type == sdl::EventType.QUIT {
            context.running = false;
        }
    }
}

fn set_controller_state() void
{
    var key_cnt: int = void;
    const keys = sdl::GetKeyboardState(&key_cnt);
    var new_state: ubyte = 0;
    if keys[sdl::Scancode.X]      { new_state |= 1 << 0; } // A
    if keys[sdl::Scancode.Z]      { new_state |= 1 << 1; } // B
    if keys[sdl::Scancode.RSHIFT] { new_state |= 1 << 2; } // Select
    if keys[sdl::Scancode.RETURN] { new_state |= 1 << 3; } // Start
    if keys[sdl::Scancode.UP]     { new_state |= 1 << 4; }
    if keys[sdl::Scancode.DOWN]   { new_state |= 1 << 5; }
    if keys[sdl::Scancode.LEFT]   { new_state |= 1 << 6; }
    if keys[sdl::Scancode.RIGHT]  { new_state |= 1 << 7; }
    context.bus.controllers[0].state = new_state;
}
