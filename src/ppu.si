import context;
import io;
import renderer;
import bus;

pub struct PPU
{
    ctrl: ubyte,
    mask: ubyte,
    status: ubyte,
    oam_addr: ubyte,

    // Internal registers
    v: ushort,
    t: ushort,
    x: ubyte,
    w: bool,

    data_buffer: ubyte,

    cycle: ulong,
    scanline: ushort,
    frame: ulong,
    frame_ready: bool,

    oam: [256]ubyte,
    vram: [0x4000]ubyte,
    palette: [32]ubyte,

    scanline_sprites: [8]Sprite,
    sprite_count: uint,
}

pub struct Sprite
{
    y: ubyte,
    tile: ubyte,
    attr: ubyte,
    x: ubyte,
    oam_index: ulong,
}

enum PPURegister : ushort
{
    CTRL,
    MASK,
    STATUS,
    OAM_ADDR,
    OAM_DATA,
    SCROLL,
    ADDR,
    DATA,
    OAM_DMA,
}

#const ppu = &context.ppu;
#const VBLANK_SCANLINE: ushort = 241;
#const PRE_RENDER_SCANLINE: ushort = 261;

pub fn power() void
{
    ppu.ctrl = 0x00;
    ppu.mask = 0x00;
    ppu.status = 0xA0;
    ppu.oam_addr = 0x00;
    ppu.w = false;
    ppu.cycle = 21;
}

pub fn tick() void
{
    ppu.cycle += 1;

    if ppu.cycle >= 341 {
        if ppu.scanline < 240 {
            renderer::render_scanline(ppu.scanline);
        }

        ppu.cycle = 0;
        ppu.scanline++;

        if ppu.scanline > PRE_RENDER_SCANLINE {
            ppu.scanline = 0;
            ppu.frame++;
            ppu.frame_ready = true;
        }
    } else if ppu.cycle == 1 {
        if ppu.scanline == VBLANK_SCANLINE {
            // ENTER VBLANK
            ppu.status |= 0x80; // set VBlank flag

            if (ppu.ctrl & 0x80) == 0x80 {
                context.cpu.nmi_pending = true;
            }
        } else if ppu.scanline == PRE_RENDER_SCANLINE {
            // EXIT VBLANK (pre-render line)
            ppu.status &= ~cast<ubyte>(0xC0);
        }
    }
}

@nodiscard
pub fn read_register(reg: ushort) ubyte
{
    switch cast<PPURegister>(reg) {
    case PPURegister.CTRL:
        io::printf("Attempted to read write-only PPUCTRL.\n");
        return 0;
    case PPURegister.MASK:
        io::printf("Attempted to read write-only PPUMASK.\n");
        return 0;
    case PPURegister.STATUS:
        const value = ppu.status;

        // clear vblank flag
        ppu.status &= ~(cast<ubyte>(0x80));
        ppu.w = false;
        return value;
    case PPURegister.OAM_ADDR:
        io::printf("Attempted to read write-only OAMADDR.\n");
        return 0;
    case PPURegister.OAM_DATA:
        return ppu.oam[ppu.oam_addr];
    case PPURegister.SCROLL:
        io::printf("Attempted to read write-only PPUSCROLL.\n");
        return 0;
    case PPURegister.ADDR:
        io::printf("Attempted to read write-only PPUADDR.\n");
        return 0;
    case PPURegister.DATA:
        const addr = ppu.v & 0x3FFF;

        var value: ubyte = void;
        if addr >= 0x3F00 {
            value = read(addr);
        } else {
            value = ppu.data_buffer;
            ppu.data_buffer = read(addr);
        }

        if (ppu.ctrl & 0x04) != 0 {
            ppu.v += 32;
        } else {
            ppu.v += 1;
        }

        return value;
    default:
        io::printf("Bad PPU register read: %hu.\n", reg);
        return 0;
    }
}

pub fn write_register(addr: ushort, value: ubyte) void
{
    const reg = addr & 7;

    switch cast<PPURegister>(reg) {
    case PPURegister.CTRL:
        ppu.ctrl = value;

        // update nametable bits in temporary VRAM address
        ppu.t &= ~cast<ushort>(0x0C00);
        ppu.t |= (cast<ushort>(value & 0x03) << 10);
    case PPURegister.MASK:
        ppu.mask = value;
    case PPURegister.STATUS:
        io::printf("Attempted to write read-only PPUSTATUS.\n");
    case PPURegister.OAM_ADDR:
        ppu.oam_addr = value;
    case PPURegister.OAM_DATA:
        ppu.oam[ppu.oam_addr] = value;
        ppu.oam_addr += 1;
    case PPURegister.SCROLL:
        if !ppu.w {
            // first write
            // coarse X + fine X
            ppu.t &= ~cast<ushort>(0x001F);
            ppu.t |= cast<ushort>(value >> 3);
            ppu.x = value & 0x07;
            ppu.w = true;
        }
        else {
            // second write
            // coarse Y + fine Y
            ppu.t &= ~cast<ushort>(0x73E0);
            ppu.t |= cast<ushort>(value & 0x07) << 12;
            ppu.t |= cast<ushort>(value & 0xF8) << 2;
            ppu.w = false;
        }
    case PPURegister.ADDR:
        if !ppu.w {
            // first write = high byte
            ppu.t &= 0x00FF;
            ppu.t |= cast<ushort>(value & 0x3F) << 8;
            ppu.w = true;
        }
        else {

            // second write = low byte

            ppu.t &= 0x7F00;
            ppu.t |= value;

            ppu.v = ppu.t;

            ppu.w = false;
        }
    case PPURegister.DATA:
        write(ppu.v & 0x3FFF, value);

        if (ppu.ctrl & 0x04) != 0 {
            ppu.v += 32;
        }
        else {
            ppu.v += 1;
        }
    default:
        io::printf("Bad PPU register write: %hu.\n", addr);
    }
}

pub fn oam_dma(page: ubyte) void
{
    const base = cast<ushort>(page) << 8;

    for i in 0..256 {
        ppu.oam[(ppu.oam_addr + i) & 0xFF] = bus::read(base + cast<ushort>(i));
    }
}

@nodiscard
fn read(addr: ushort) ubyte
{
    const a = addr & 0x3FFF;

    // Pattern tables (CHR ROM/RAM)
    if a < 0x2000 {
        return context.cart!.mapper.ppu_read(addr);
    }

    // Nametables
    if a < 0x3F00 {
        const mirrored = context.cart!.mapper.mirror_vram_addr(a);
        return ppu.vram[mirrored];
    }

    // Palette RAM mirrors every 32 bytes, and some special mirroring rules later
    return ppu.palette[palette_mirror(a)];
}

fn write(addr: ushort, value: ubyte) void
{
    const a = addr & 0x3FFF;

    // Pattern tables (CHR ROM/RAM)
    if a < 0x2000 {
        context.cart!.mapper.ppu_write(addr, value);
        return;
    }

    // Nametables
    if a < 0x3F00 {
        const mirrored = context.cart!.mapper.mirror_vram_addr(a);
        ppu.vram[mirrored] = value;
        return;
    }

    // Palette RAM mirrors every 32 bytes, and some special mirroring rules later
    ppu.palette[palette_mirror(a)] = value;
}

fn palette_mirror(addr: ushort) ushort
{
    var pal = addr & 0x1F;

    if pal == 0x10 { pal = 0x00; }
    if pal == 0x14 { pal = 0x04; }
    if pal == 0x18 { pal = 0x08; }
    if pal == 0x1C { pal = 0x0C; }
    return pal;
}
