import CString;
import io;
import malloc;

#const NES_CONSTANT: uint = 0x1A53454E;

pub struct ROMHeader
{
    nes_constant: uint,
    prg_rom_size: ubyte,
    chr_rom_size: ubyte,
    flags6: ubyte,
    flags7: ubyte,
    flags8: ubyte,
    flags9: ubyte,
    flags10: ubyte,
    reserved: [5]ubyte,
}

pub struct NesROM
{
    header: *ROMHeader,
    prg: []ubyte,
    chr: []ubyte,
}

pub fn NesROM.from_file(file_path: CString) ?NesROM
{
    const fd = io::open(file_path, io::O_RDONLY);
    if fd < 0 {
        io::fprintf(io::stderr, "Failed to open file %s\n", file_path);
        return null;
    }

    const sz = cast<usize>(io::lseek(fd, 0, io::SEEK_END));
    io::lseek(fd, 0, io::SEEK_SET);

    const buf = cast<*ROMHeader>(malloc(sz));
    io::read(fd, buf, sz);
    io::close(fd);
    const prg_size = cast<uint>(buf.prg_rom_size) * 0x4000;
    const chr_size = cast<uint>(buf.chr_rom_size) * 0x2000;
    if buf.nes_constant != NES_CONSTANT {
        io::printf("Rom \'%s\' was detected to be invalid.\n", file_path);
        return null;
    }

    const data = cast<*[*]ubyte>(buf);
    var prg_offset: usize = #sizeof(ROMHeader);
    io::printf("offset: %lu\n", prg_offset);
    if (buf.flags6 & 0x04) != 0 {
        prg_offset += 512;
    }
    const chr_offset = prg_offset + prg_size;
    io::printf("Successfully loaded rom '%s' PRG_SIZE: %u  CHR_SIZE: %u\n", file_path, prg_size, chr_size);
    return NesROM {
        header: buf,
        prg: data[prg_offset..chr_offset],
        chr: data[chr_offset..chr_offset + chr_size],
    };
}
