import context;
import sdl;
import io;
import bus;
import apu;
import pthread;

pub struct Player
{
    stream: ?*sdl::AudioStream,
    buffer: AudioBuffer,
    sample_rate: int,
}

pub struct AudioBuffer
{
    mutex: pthread::Mutex,
    samples: [2048]float,
    count: usize,
    head: usize,
}

#const player: *Player = &context.audio_player;

pub fn init(sample_rate: int) bool
{
    player.sample_rate = sample_rate;
    const spec = sdl::AudioSpec{
        format: sdl::AudioFormat.F32,
        channels: 1,
        freq: sample_rate,
    };

    player.stream = sdl::OpenAudioDeviceStream(sdl::AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, null, null);
    if player.stream == null 
    { 
        io::printf("Failed to open audio device: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    sdl::ResumeAudioStreamDevice(player.stream!);
    return true;
}

var null_buf: [1024]float;

pub fn push_sample(sample: float) void
{
    player.buffer.push(sample);
}

pub fn AudioBuffer.push(buffer: *AudioBuffer, sample: float) void
{
    buffer.mutex.lock();
    if buffer.count < buffer.samples.len
    {
        buffer.samples[buffer.head] = sample;
        buffer.count++;
        buffer.head = (buffer.head + 1) % buffer.samples.len;
    }
    buffer.mutex.unlock();
}

