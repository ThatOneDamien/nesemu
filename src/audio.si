import context;
import sdl;
import io;
import bus;
import apu;
import pthread;

pub struct Player
{
    stream: ?*sdl::AudioStream,
    buffer: AudioBuffer,
    sample_rate: int,
}

pub struct AudioBuffer
{
    mutex: pthread::Mutex,
    samples: [2048]float,
    count: usize,
    head: usize,
}

#const player: *Player = &context.audio_player;

pub fn init(sample_rate: int) bool
{
    player.sample_rate = sample_rate;
    const spec = sdl::AudioSpec{
        format: sdl::AudioFormat.F32,
        channels: 1,
        freq: sample_rate,
    };

    player.stream = sdl::OpenAudioDeviceStream(sdl::AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, &audio_callback, null);
    if player.stream == null 
    { 
        io::printf("Failed to open audio device: %s\n", sdl::GetError());
        sdl::Quit();
        return false;
    }

    sdl::ResumeAudioStreamDevice(player.stream!);
    return true;
}

